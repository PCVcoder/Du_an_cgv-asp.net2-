@{
    ViewData["Title"] = "Đăng Ký / Đăng Nhập Thành Viên CGV";
}

@section Styles {
<style>
    .container { max-width: 960px; margin: 0 auto; padding: 32px 16px 48px; display: grid; grid-template-columns: 1fr minmax(280px, 380px); gap: 40px; align-items: start; }
    
    /* Left form box */
    .form-box { background: white; border-radius: 6px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .tabs { display: grid; grid-template-columns: 1fr 1fr; background: #b0000e; }
    .tab {
        padding: 14px; font-weight: 700; font-size: 0.95rem; letter-spacing: 1px; color: #ffcccc;
        background: #b0000e; border: none; border-bottom: 3px solid transparent; cursor: pointer; transition: 0.15s;
    }
    .tab.active { background: #e30613; color: white; border-bottom-color: white; }
    .tab:hover { background: #c00010; color: white; }
    
    .form-content { padding: 28px 32px 32px; display: flex; flex-direction: column; gap: 16px; width: 100%; }
    .form-content.hidden { display: none !important; }
    .input-group { width: 100%; display: flex; flex-direction: column; }
    .input-group label { display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; color: #222; }
    .req { color: #e30613; margin-left: 2px; }
    
    .form-control {
        width: 100%; padding: 11px 14px; font-size: 0.88rem; border: 1px solid #ccc; border-radius: 3px;
        outline: none; background: white; color: #222; transition: border-color 0.15s;
    }
    .form-control:focus { border-color: #e30613; }
    select.form-control { cursor: pointer; }
    
    .btn-submit {
        background: #e30613; color: white; font-weight: 800; font-size: 0.95rem; padding: 14px; border: none;
        border-radius: 3px; cursor: pointer; letter-spacing: 1px; width: 100%; margin-top: 6px; transition: background 0.15s;
    }
    .btn-submit:hover { background: #c00; }
    
    /* Right sidebar */
    .sidebar { position: sticky; top: 20px; }
    .benefit-box { background: white; border-radius: 6px; padding: 32px 24px 24px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); text-align: center; }
    .benefit-title { font-family: 'Montserrat', 'Roboto', sans-serif; font-weight: 800; font-size: 1.15rem; color: #111; margin: 0 0 10px; letter-spacing: 0.5px; }
    
    .tier-box { margin-top: 20px; background: white; border-radius: 6px; padding: 20px 24px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .tier-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .tier-dot { width: 12px; height: 12px; border-radius: 50%; }
</style>
}

<div class="container">
    <!-- LEFT: Form Box -->
    <div class="form-box">
        <div class="tabs">
            <button type="button" class="tab" id="tab-login" onclick="switchAuthTab('login')">ĐĂNG NHẬP</button>
            <button type="button" class="tab active" id="tab-register" onclick="switchAuthTab('register')">ĐĂNG KÝ</button>
        </div>
        
        <!-- REGISTER FORM -->
        <div class="form-content" id="register-form">
            <div class="input-group">
                <label>Họ và tên<span class="req">*</span></label>
                <input type="text" class="form-control" placeholder="Nhập họ và tên đầy đủ" required>
            </div>
            
            <div class="input-group">
                <label>Số điện thoại<span class="req">*</span></label>
                <input type="tel" class="form-control" placeholder="Nhập số điện thoại di động" required>
            </div>
            
            <div class="input-group">
                <label>Email<span class="req">*</span></label>
                <input type="email" class="form-control" placeholder="Nhập địa chỉ email" required>
            </div>
            
            <div class="input-group">
                <label>Mật khẩu<span class="req">*</span></label>
                <input type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required>
            </div>
            
            <div class="input-group">
                <label>Ngày sinh<span class="req">*</span></label>
                <div style="display: flex; gap: 8px;">
                    <select class="form-control" style="flex: 1;" id="dob-day">
                        <option value="">Ngày</option>
                    </select>
                    <select class="form-control" style="flex: 1;" id="dob-month">
                        <option value="">Tháng</option>
                    </select>
                    <select class="form-control" style="flex: 1;" id="dob-year">
                        <option value="">Năm</option>
                    </select>
                </div>
            </div>

            <div class="input-group">
                <label>Khu vực<span class="req">*</span></label>
                <select class="form-control">
                    <option>Hồ Chí Minh</option>
                    <option>Hà Nội</option>
                    <option>Đà Nẵng</option>
                    <option>Cần Thơ</option>
                    <option>Hải Phòng</option>
                    <option>Bình Dương</option>
                    <option>Đồng Nai</option>
                    <option>Khánh Hòa / Nha Trang</option>
                </select>
            </div>
            
            <div class="input-group">
                <label>Rạp CGV yêu thích<span class="req">*</span></label>
                <select class="form-control">
                    <option>CGV Sư Vạn Hạnh</option>
                    <option>CGV Vincom Đồng Khởi</option>
                    <option>CGV Landmark 81</option>
                    <option>CGV Crescent Mall</option>
                    <option>CGV Hùng Vương Plaza</option>
                    <option>CGV Vincom Bà Triệu</option>
                    <option>CGV Aeon Tân Phú</option>
                    <option>CGV Vincom Đà Nẵng</option>
                </select>
            </div>

            <div class="input-group">
                <label style="display: flex; gap: 10px; align-items: start; font-weight: normal; cursor: pointer;">
                    <input type="checkbox" style="margin-top: 3px; accent-color: #e30613;" checked>
                    <span style="font-size: 0.82rem; color: #333; line-height: 1.5;">Bằng việc bấm nút "Đăng Ký" bên dưới, tôi đồng ý với Chính Sách Bảo Mật và Điều Khoản Sử Dụng Của CGV.</span>
                </label>
            </div>

            <button type="button" class="btn-submit" onclick="alert('Đăng ký tài khoản CGV thành công! Vui lòng đăng nhập.')">ĐĂNG KÝ THÀNH VIÊN</button>
        </div>

        <!-- LOGIN FORM -->
        <div class="form-content hidden" id="login-form">
            <div class="input-group">
                <label>Email hoặc Số điện thoại<span class="req">*</span></label>
                <input type="text" class="form-control" placeholder="Nhập email hoặc số điện thoại" required>
            </div>
            
            <div class="input-group">
                <label>Mật khẩu<span class="req">*</span></label>
                <input type="password" class="form-control" placeholder="Nhập mật khẩu" required>
            </div>

            <div class="input-group" style="flex-direction: row; justify-content: space-between; align-items: center; margin-top: -4px;">
                <label style="display: flex; gap: 8px; align-items: center; font-weight: normal; cursor: pointer; margin: 0;">
                    <input type="checkbox" style="accent-color: #e30613;" checked>
                    <span style="font-size: 0.82rem; color: #555;">Ghi nhớ đăng nhập</span>
                </label>
                <a href="#" style="font-size: 0.82rem; color: #e30613; text-decoration: none; font-weight: 600;">Quên mật khẩu?</a>
            </div>

            <button type="button" class="btn-submit" onclick="window.location.href='@Url.Action("Profile", "Account")'">ĐĂNG NHẬP</button>
        </div>
    </div>

    <!-- RIGHT: Sidebar Info -->
    <div class="sidebar">
        <div class="benefit-box">
            <div style="font-size: 5rem; margin-bottom: 16px;">🎁</div>
            <h3 class="benefit-title">QUÀ TẶNG SINH NHẬT</h3>
            <p style="font-size: 0.85rem; color: #555; line-height: 1.6; margin: 0 0 20px;">Quà tặng vé xem phim & bắp nước đặc quyền dành cho cả 4 cấp độ thành viên trong tháng sinh nhật!</p>
            
            <div style="display: flex; justify-content: center; gap: 8px;">
                <div style="width: 10px; height: 10px; border-radius: 50%; background: #e30613;"></div>
                <div style="width: 10px; height: 10px; border-radius: 50%; background: #ccc;"></div>
                <div style="width: 10px; height: 10px; border-radius: 50%; background: #ccc;"></div>
            </div>
        </div>

        <div class="tier-box">
            <h4 style="font-family: 'Montserrat', 'Roboto', sans-serif; font-weight: 800; font-size: 1rem; color: #111; margin: 0 0 14px; letter-spacing: 0.5px;">CẤP ĐỘ THÀNH VIÊN</h4>
            <div class="tier-row"><div class="tier-dot" style="background: #888;"></div><span style="font-weight: 700; font-size: 0.82rem; color: #888; min-width: 65px;">Standard</span><span style="font-size: 0.78rem; color: #777;">từ 0 điểm</span></div>
            <div class="tier-row"><div class="tier-dot" style="background: #aaa;"></div><span style="font-weight: 700; font-size: 0.82rem; color: #666; min-width: 65px;">Silver</span><span style="font-size: 0.78rem; color: #777;">từ 500K điểm</span></div>
            <div class="tier-row"><div class="tier-dot" style="background: #c9a227;"></div><span style="font-weight: 700; font-size: 0.82rem; color: #c9a227; min-width: 65px;">Gold</span><span style="font-size: 0.78rem; color: #777;">từ 2,000K điểm</span></div>
            <div class="tier-row"><div class="tier-dot" style="background: #0288d1;"></div><span style="font-weight: 700; font-size: 0.82rem; color: #0288d1; min-width: 65px;">Diamond</span><span style="font-size: 0.78rem; color: #777;">từ 5,000K điểm</span></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function switchAuthTab(tab) {
        const loginTab = document.getElementById('tab-login');
        const registerTab = document.getElementById('tab-register');
        const loginForm = document.getElementById('login-form');
        const registerForm = document.getElementById('register-form');
        
        if (tab === 'login') {
            loginTab.classList.add('active');
            registerTab.classList.remove('active');
            loginForm.classList.remove('hidden');
            registerForm.classList.add('hidden');
        } else {
            registerTab.classList.add('active');
            loginTab.classList.remove('active');
            registerForm.classList.remove('hidden');
            loginForm.classList.add('hidden');
        }
    }

    // Populate Ngày, Tháng, Năm
    (function() {
        const daySelect = document.getElementById('dob-day');
        const monthSelect = document.getElementById('dob-month');
        const yearSelect = document.getElementById('dob-year');

        if (daySelect && monthSelect && yearSelect) {
            for (let d = 1; d <= 31; d++) {
                const opt = document.createElement('option');
                opt.value = d;
                opt.textContent = (d < 10 ? '0' : '') + d;
                daySelect.appendChild(opt);
            }
            for (let m = 1; m <= 12; m++) {
                const opt = document.createElement('option');
                opt.value = m;
                opt.textContent = (m < 10 ? '0' : '') + m;
                monthSelect.appendChild(opt);
            }
            const currentYear = new Date().getFullYear();
            for (let y = currentYear - 12; y >= 1950; y--) {
                const opt = document.createElement('option');
                opt.value = y;
                opt.textContent = y;
                yearSelect.appendChild(opt);
            }
        }
    })();
</script>
}

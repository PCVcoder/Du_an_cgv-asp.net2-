@model List<Du_an_CGV.Models.Cinema>
@{
    ViewData["Title"] = "Hệ Thống Rạp CGV Toàn Quốc";
    var cities = (List<string>?)ViewBag.Cities ?? new List<string>();
    var activeCity = (string?)ViewBag.ActiveCity ?? "Hồ Chí Minh";
    var cinemaCounts = (Dictionary<string, int>?)ViewBag.CinemaCounts ?? new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

    // List of HCM cinemas in exact order of Image 4 columns
    var hcmOrder = new List<string>
    {
        // Cột 1
        "CGV Hùng Vương Plaza",
        "CGV Vivo City",
        "CGV Menas Mall (CGV CT Plaza)",
        "CGV Hoàng Văn Thụ",
        "CGV Vincom Center Landmark 81",
        "CGV Vincom Mega Mall Grand Park",
        // Cột 2
        "CGV Crescent Mall",
        "CGV Pearl Plaza",
        "CGV Pandora City",
        "CGV Aeon Bình Tân",
        "CGV Satra Củ Chi",
        // Cột 3
        "CGV Thảo Điền Pearl",
        "CGV Liberty Citypoint",
        "CGV Aeon Tân Phú",
        "CGV Saigonres Nguyễn Xí",
        "CGV Gigamall Thủ Đức",
        // Cột 4
        "CGV Vincom Thủ Đức",
        "CGV Vincom Đồng Khởi",
        "CGV Vincom Gò Vấp",
        "CGV Sư Vạn Hạnh",
        "CGV Lý Chính Thắng"
    };

    var currentCinemas = Model
        .Where(c => string.Equals(c.City, activeCity, StringComparison.OrdinalIgnoreCase))
        .ToList();

    if (string.Equals(activeCity, "Hồ Chí Minh", StringComparison.OrdinalIgnoreCase))
    {
        currentCinemas = currentCinemas
            .OrderBy(c => {
                var idx = hcmOrder.IndexOf(c.Name);
                return idx >= 0 ? idx : 999;
            })
            .ThenBy(c => c.Name)
            .ToList();
    }
    else
    {
        currentCinemas = currentCinemas.OrderBy(c => c.Name).ToList();
    }
}

@section Styles {
<style>
    .cgv-cinema-container {
        max-width: 1040px;
        margin: 24px auto 48px;
        padding: 0 16px;
    }

    .breadcrumb-nav {
        font-size: 0.85rem;
        color: #777;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
    }
    .breadcrumb-nav a {
        color: #e30613;
        text-decoration: none;
    }
    .breadcrumb-nav a:hover {
        text-decoration: underline;
    }

    /* Khung rạp CGV chuẩn phong cách cổ điển trong ảnh 3 & 4 */
    .cgv-vintage-box {
        background-color: #2b2b2b;
        background-image: radial-gradient(circle at 50% 30%, #343434 0%, #242424 100%);
        border-radius: 4px;
        padding: 40px 48px;
        position: relative;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    /* Viền chỉ bên trong và họa tiết 4 góc */
    .inner-border {
        position: absolute;
        top: 14px;
        bottom: 14px;
        left: 14px;
        right: 14px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        pointer-events: none;
        border-radius: 2px;
    }

    .corner-ornament {
        position: absolute;
        width: 14px;
        height: 14px;
        border-color: rgba(255, 255, 255, 0.35);
        border-style: solid;
        pointer-events: none;
    }
    .corner-ornament.top-left {
        top: 10px;
        left: 10px;
        border-width: 2px 0 0 2px;
        border-top-left-radius: 4px;
    }
    .corner-ornament.top-right {
        top: 10px;
        right: 10px;
        border-width: 2px 2px 0 0;
        border-top-right-radius: 4px;
    }
    .corner-ornament.bottom-left {
        bottom: 10px;
        left: 10px;
        border-width: 0 0 2px 2px;
        border-bottom-left-radius: 4px;
    }
    .corner-ornament.bottom-right {
        bottom: 10px;
        right: 10px;
        border-width: 0 2px 2px 0;
        border-bottom-right-radius: 4px;
    }

    /* Tiêu đề CGV CINEMAS */
    .cgv-cinemas-title {
        font-family: 'Montserrat', 'Arial Black', sans-serif;
        font-size: 2.3rem;
        font-weight: 900;
        letter-spacing: 5px;
        color: #cccccc;
        text-align: center;
        margin: 0 0 34px 0;
        text-shadow: 0 1px 1px #ffffff, 0 2px 4px rgba(0, 0, 0, 0.8), 0 4px 10px rgba(0, 0, 0, 0.9);
    }

    /* Lưới 33 Tỉnh / Thành phố - 5 cột đúng theo hình 3 */
    .cgv-city-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        column-gap: 20px;
        row-gap: 12px;
        margin-bottom: 24px;
    }

    .cgv-city-link {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.94rem;
        font-weight: 600;
        color: #d1d1d1;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 3px 0;
        transition: color 0.15s ease, transform 0.15s ease;
        line-height: 1.4;
    }
    .cgv-city-link:hover {
        color: #ffffff;
        text-decoration: none;
    }
    .cgv-city-link.active {
        color: #e30613 !important;
        font-weight: 700;
    }
    .cgv-city-link .city-count {
        font-size: 0.72rem;
        color: #777;
        font-weight: normal;
        margin-left: 4px;
    }
    .cgv-city-link.active .city-count {
        color: #e30613;
    }

    /* Đường kẻ phân cách */
    .cgv-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.2);
        margin: 20px 0 28px;
    }

    /* Danh sách rạp theo thành phố - 4 cột theo đúng hình 4 */
    .cgv-cinema-columns {
        column-count: 4;
        column-gap: 32px;
    }
    @@media (max-width: 900px) {
        .cgv-city-grid { grid-template-columns: repeat(3, 1fr); }
        .cgv-cinema-columns { column-count: 2; }
    }
    @@media (max-width: 600px) {
        .cgv-city-grid { grid-template-columns: repeat(2, 1fr); }
        .cgv-cinema-columns { column-count: 1; }
        .cgv-vintage-box { padding: 30px 20px; }
        .cgv-cinemas-title { font-size: 1.7rem; }
    }

    .cgv-cinema-item {
        display: block;
        break-inside: avoid;
        margin-bottom: 15px;
    }
    .cgv-cinema-item a {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.92rem;
        font-weight: 500;
        color: #b5b5b5;
        text-decoration: none;
        display: block;
        line-height: 1.35;
        transition: color 0.15s ease, transform 0.15s ease;
    }
    .cgv-cinema-item a:hover {
        color: #ffffff;
        text-decoration: underline;
        transform: translateX(3px);
    }

    .cgv-empty-notice {
        text-align: center;
        color: #888;
        padding: 24px;
        font-size: 0.95rem;
    }
    .cgv-empty-notice a {
        color: #e30613;
        font-weight: 600;
        text-decoration: underline;
    }
</style>
}

<main class="cgv-cinema-container">
    <nav class="breadcrumb-nav">
        <a asp-controller="Home" asp-action="Index">🏠 Trang chủ</a>
        <span>›</span>
        <span style="color: #333; font-weight: 600;">Hệ Thống Rạp CGV</span>
    </nav>

    <div class="cgv-vintage-box">
        <!-- Viền và họa tiết 4 góc phong cách CGV cổ điển -->
        <div class="inner-border"></div>
        <div class="corner-ornament top-left"></div>
        <div class="corner-ornament top-right"></div>
        <div class="corner-ornament bottom-left"></div>
        <div class="corner-ornament bottom-right"></div>

        <!-- Tiêu đề CGV CINEMAS -->
        <h1 class="cgv-cinemas-title">CGV CINEMAS</h1>

        <!-- Lưới 33 Tỉnh / Thành phố - 5 cột (Hình 3) -->
        <div class="cgv-city-grid">
            @foreach (var city in cities)
            {
                var isActive = string.Equals(city, activeCity, StringComparison.OrdinalIgnoreCase);
                cinemaCounts.TryGetValue(city, out var count);
                <a asp-controller="Cinema" asp-action="Index" asp-route-city="@city" 
                   class="cgv-city-link @(isActive ? "active" : "")"
                   title="@(count > 0 ? $"{count} cụm rạp tại {city}" : $"Chưa có rạp tại {city}")">
                    <span>@city</span>
                    @if (count > 0)
                    {
                        <span class="city-count">(@count)</span>
                    }
                </a>
            }
        </div>

        <!-- Đường gạch ngang phân cách -->
        <div class="cgv-divider"></div>

        <!-- Thanh tiêu đề khu vực & tìm kiếm nhanh rạp -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 22px;">
            <div style="font-size: 0.95rem; font-weight: 700; color: #eee;">
                🎬 Cụm rạp CGV tại <span style="color: #e30613;">@activeCity</span> (@currentCinemas.Count rạp):
            </div>
            <div style="position: relative; max-width: 330px; width: 100%;">
                <input type="text" id="public-cinema-search" 
                       placeholder="🔍 Tìm nhanh cụm rạp tại @activeCity..." 
                       oninput="searchPublicCinemas()" 
                       style="width: 100%; background: #1c1c1c; border: 1px solid #4a4a4a; border-radius: 20px; padding: 7px 14px 7px 34px; color: #ffffff; font-size: 0.83rem; outline: none; transition: border-color 0.2s, box-shadow 0.2s;" />
                <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 0.82rem; color: #888;">🔍</span>
            </div>
        </div>

        <!-- Danh sách các rạp thuộc thành phố được chọn - 4 cột (Hình 4) -->
        @if (currentCinemas.Any())
        {
            <div class="cgv-cinema-columns" id="public-cinemas-container">
                @foreach (var c in currentCinemas)
                {
                    <div class="cgv-cinema-item">
                        <a asp-controller="Cinema" asp-action="Movies" asp-route-id="@c.Id" title="Xem lịch chiếu phim tại @c.Name: @c.Address">
                            @c.Name
                        </a>
                    </div>
                }
            </div>
            <div id="public-no-cinema-msg" style="display: none; text-align: center; color: #888; padding: 24px; font-size: 0.9rem;">
                Không tìm thấy cụm rạp nào phù hợp với từ khóa tìm kiếm.
            </div>
        }
        else
        {
            <div class="cgv-empty-notice">
                Hiện tại CGV chưa có cụm rạp tại khu vực <strong>@activeCity</strong>.<br />
                Quý khách có thể xem lịch chiếu tại <a asp-controller="Cinema" asp-action="Index" asp-route-city="Hồ Chí Minh">Hồ Chí Minh (21 rạp)</a> hoặc <a asp-controller="Cinema" asp-action="Index" asp-route-city="Hà Nội">Hà Nội (5 rạp)</a>.
            </div>
        }
    </div>
</main>

@section Scripts {
<script>
    function searchPublicCinemas() {
        const query = (document.getElementById('public-cinema-search')?.value || '').trim().toLowerCase();
        const items = document.querySelectorAll('.cgv-cinema-item');
        const emptyMsg = document.getElementById('public-no-cinema-msg');
        let count = 0;
        items.forEach(item => {
            const text = (item.textContent || '').toLowerCase();
            if (query === '' || text.includes(query)) {
                item.style.display = '';
                count++;
            } else {
                item.style.display = 'none';
            }
        });
        if (emptyMsg) {
            emptyMsg.style.display = (count === 0 && items.length > 0) ? 'block' : 'none';
        }
    }
</script>
}


@model List<Du_an_CGV.Models.Showtime>
@{
    var cinema = (Du_an_CGV.Models.Cinema?)ViewBag.Cinema;
    ViewData["Title"] = $"Lịch Chiếu Phim - {cinema?.Name ?? "CGV"}";
    var movies = Model.Select(s => s.Movie).Where(m => m != null).DistinctBy(m => m!.Id).ToList();
}

@section Styles {
<style>
    .cinema-header {
        background: #242424; color: white; border-radius: 6px; padding: 24px 28px; margin-bottom: 28px;
        border-left: 5px solid #e30613; box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .movie-card {
        position: relative; border-radius: 4px; overflow: hidden; cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s; background: white; border: 1px solid #e0e0e0;
        display: flex; flex-direction: column;
    }
    .movie-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.12); }
    .movie-card img { width: 100%; height: 260px; object-fit: cover; display: block; }
    .movie-info { background: rgba(0, 0, 0, 0.88); padding: 8px 10px; }
    .movie-title { color: white; font-weight: 700; font-size: 0.82rem; margin: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-transform: uppercase; }
    .rating-badge { position: absolute; top: 6px; left: 6px; color: white; font-size: 0.6rem; font-weight: 700; padding: 2px 6px; border-radius: 2px; z-index: 2; }
    .showtime-badge {
        background: #f0f0f0; border: 1px solid #ccc; color: #111; font-weight: 700; font-size: 0.78rem;
        padding: 5px 10px; border-radius: 3px; text-decoration: none; display: inline-block; transition: 0.15s;
    }
    .showtime-badge:hover { background: #e30613; color: white; border-color: #e30613; }
</style>
}

<main style="max-width: 960px; margin: 0 auto; padding: 24px 16px 56px; min-height: 65vh;">
    <a asp-controller="Cinema" asp-action="Index" style="display: inline-block; color: #e30613; font-size: 0.82rem; font-weight: 700; margin-bottom: 18px;">← Chọn rạp khác</a>

    <!-- Cinema Header -->
    <header class="cinema-header">
        <p style="color: #bbb; font-size: 0.78rem; margin: 0 0 6px;">Khu vực: @(cinema?.City ?? "Hồ Chí Minh") · Hotline: @(cinema?.Hotline ?? "1900 6017")</p>
        <h1 style="font-family: 'Montserrat', 'Roboto', sans-serif; font-size: 1.6rem; font-weight: 800; letter-spacing: 0.5px; margin: 0;">@(cinema?.Name ?? "CGV Cinemas")</h1>
        <p style="color: #999; font-size: 0.78rem; margin: 6px 0 0;">@(cinema?.Address ?? "Địa chỉ rạp chiếu CGV")</p>
    </header>

    <!-- Đang chiếu tại rạp -->
    <section style="margin-bottom: 38px;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #e30613; padding-bottom: 8px; margin-bottom: 18px;">
            <h2 style="font-family: 'Montserrat', 'Roboto', sans-serif; font-size: 1.35rem; font-weight: 800; margin: 0; color: #1a1a1a;">PHIM ĐANG CHIẾU TẠI RẠP</h2>
            <span style="color: #777; font-size: 0.78rem; font-weight: 600;">@movies.Count phim</span>
        </div>
        
        @if (movies.Any())
        {
            <div class="grid-4">
                @foreach (var m in movies)
                {
                    <div class="movie-card">
                        <div class="rating-badge" style="background: @m!.RatingColor;">@m.Rating</div>
                        <img src="@m.PosterUrl" alt="@m.Title" onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=400'">
                        <div class="movie-info">
                            <p class="movie-title">@m.Title</p>
                        </div>
                        <div style="padding: 10px; background: white; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                            <div style="margin-bottom: 8px;">
                                <div style="font-size: 0.75rem; color: #666; margin-bottom: 6px;">Suất chiếu & Định dạng:</div>
                                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                    @{
                                        var movieShowtimes = Model.Where(s => s.MovieId == m.Id && s.StartTime.Date >= DateTime.Today).OrderBy(s => s.StartTime).Take(4);
                                    }
                                    @foreach (var st in movieShowtimes)
                                    {
                                        <a asp-controller="Booking" asp-action="Index" asp-route-movieId="@m.Id" asp-route-cinemaId="@cinema?.Id" asp-route-showtimeId="@st.Id" class="showtime-badge" title="Định dạng @st.Format - Giá @st.Price.ToString("N0")đ">
                                            <strong>@st.StartTime.ToString("HH:mm")</strong>
                                            <span style="font-size: 0.65rem; color: #b71c1c; font-weight: 700; margin-left: 2px;">@st.Format</span>
                                        </a>
                                    }
                                </div>
                            </div>
                            <a asp-controller="Booking" asp-action="Index" asp-route-movieId="@m.Id" asp-route-cinemaId="@cinema?.Id" style="display: block; background: #e30613; color: white; text-align: center; padding: 7px 0; border-radius: 3px; font-weight: 700; font-size: 0.8rem; text-decoration: none;">
                                ĐẶT VÉ
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="background: white; border-radius: 6px; padding: 40px; text-align: center;">
                <p style="color: #666; font-size: 0.95rem;">Hôm nay chưa có lịch chiếu tại rạp này. Quý khách vui lòng chọn cụm rạp khác.</p>
                <a asp-controller="Cinema" asp-action="Index" style="display:inline-block;margin-top:10px;background:#e30613;color:white;padding:8px 18px;border-radius:4px;font-weight:700;font-size:0.85rem;text-decoration:none;">Xem danh sách rạp khác</a>
            </div>
        }
    </section>
</main>

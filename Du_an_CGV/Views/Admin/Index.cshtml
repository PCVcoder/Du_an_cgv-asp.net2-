    // ==========================================================
    // THỐNG KÊ DOANH THU & BÁO CÁO (REVENUE & REPORTING)
    // ==========================================================
    let repChartTimeline = null;
    let repChartMix = null;
    let repChartMovies = null;
    let repChartCinemas = null;
    let repReportLoadedOnce = false;

    // Thiết lập phím tắt khoảng thời gian
    function setReportDatePreset(preset, btn) {
        document.querySelectorAll('.rep-preset-btn').forEach(b => {
            b.classList.remove('active');
            b.style.background = 'white';
            b.style.color = '#334155';
            b.style.border = '1px solid #cbd5e1';
            b.style.fontWeight = '600';
        });
        if (btn) {
            btn.classList.add('active');
            btn.style.background = '#e30613';
            btn.style.color = 'white';
            btn.style.border = '1px solid #e30613';
            btn.style.fontWeight = '700';
        }

        const today = new Date();
        const formatDateStr = (d) => {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        };

        const fromInput = document.getElementById('rep-from-date');
        const toInput = document.getElementById('rep-to-date');
        if (!fromInput || !toInput) return;

        toInput.value = formatDateStr(today);

        if (preset === 'today') {
            fromInput.value = formatDateStr(today);
        } else if (preset === '7days') {
            const d7 = new Date();
            d7.setDate(today.getDate() - 6);
            fromInput.value = formatDateStr(d7);
        } else if (preset === '30days') {
            const d30 = new Date();
            d30.setDate(today.getDate() - 29);
            fromInput.value = formatDateStr(d30);
        } else if (preset === 'thismonth') {
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            fromInput.value = formatDateStr(firstDay);
        } else if (preset === 'alltime') {
            fromInput.value = '2024-01-01';
        }

        loadRevenueReport();
    }

    function resetReportFilters() {
        const cinemaSelect = document.getElementById('rep-cinema-filter');
        if (cinemaSelect) cinemaSelect.value = '';
        const movieSelect = document.getElementById('rep-movie-filter');
        if (movieSelect) movieSelect.value = '';
        
        const preset30 = document.querySelectorAll('.rep-preset-btn')[2];
        setReportDatePreset('30days', preset30);
    }

    // Chuyển tab bảng con trong Báo cáo
    function switchReportSubTable(type, btn) {
        document.querySelectorAll('.rep-table-tab').forEach(b => {

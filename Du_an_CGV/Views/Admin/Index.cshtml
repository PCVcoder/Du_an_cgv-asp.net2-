            <div style="display: flex; align-items: center; gap: 10px;">
                <h3 style="margin: 0; color: #111; font-size: 1.25rem;">📋 Chi Tiết & Báo Giá Sự Kiện / Thuê Rạp</h3>
                <span id="rental-modal-badge-big" class="badge" style="background: linear-gradient(135deg, #b71c1c, #e53935); color: #fff; font-weight: 700; font-size: 0.72rem; display: none;">⭐ Quy mô lớn (VIP)</span>
            </div>
            <button type="button" onclick="closeModal('modal-rental-detail')" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #666;">&times;</button>

                </label>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 14px;">
                <button type="button" class="btn-action" style="background:#888;color:white;padding:8px 16px;" onclick="closeModal('promo-modal')">Hủy</button>
                <button type="submit" class="btn-add">Lưu Ưu Đãi</button>
            </div>
        </form>
    </div>
</div>


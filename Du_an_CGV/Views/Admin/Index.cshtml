    // 4. Lọc dữ liệu thao tác real-time
    function filterActionLogs() {
        const city = (document.getElementById('filter-log-city')?.value || '').trim().toLowerCase();
        const cinemaId = (document.getElementById('filter-log-cinema')?.value || '').trim();
        const actionType = (document.getElementById('filter-log-actiontype')?.value || '').trim();
        const module = (document.getElementById('filter-log-module')?.value || '').trim();
        const startDate = document.getElementById('filter-log-start')?.value || '';
        const endDate = document.getElementById('filter-log-end')?.value || '';
        const search = (document.getElementById('filter-log-search')?.value || '').trim().toLowerCase();

        const rows = document.querySelectorAll('.log-row');
        let matched = 0;

        rows.forEach(row => {
            const rCity = (row.dataset.city || '').toLowerCase();
            const rCinemaId = row.dataset.cinemaId || '0';
            const rActionType = row.dataset.actiontype || '';
            const rModule = row.dataset.module || '';
            const rDate = row.dataset.date || '';
            const rSearch = (row.dataset.search || '').toLowerCase();

            let isMatch = true;

            if (city) {
                if (city === 'toàn quốc') {
                    if (!rCity.includes('toàn quốc') && rCinemaId !== '0') isMatch = false;
                } else if (rCity !== city) {
                    isMatch = false;
                }
            }
            if (cinemaId && rCinemaId !== cinemaId) isMatch = false;
            if (actionType && rActionType !== actionType) isMatch = false;
            if (module && rModule !== module) isMatch = false;
            if (startDate && rDate < startDate) isMatch = false;
            if (endDate && rDate > endDate) isMatch = false;
            if (search && !rSearch.includes(search)) isMatch = false;

            if (isMatch) {
                row.style.display = '';
                matched++;
            } else {
                row.style.display = 'none';
            }
        });

        const countBadge = document.getElementById('logs-count-badge');
        if (countBadge) countBadge.textContent = `${matched} thao tác`;
        const shownCount = document.getElementById('log-shown-count');
        if (shownCount) shownCount.textContent = matched;

        const emptyRow = document.getElementById('log-empty-row');
        if (emptyRow) {
            emptyRow.style.display = matched === 0 ? '' : 'none';
        }
    }

    function resetLogFilter() {
        document.getElementById('filter-log-city').value = '';
        onLogCityChanged();
        document.getElementById('filter-log-cinema').value = '';
        document.getElementById('filter-log-actiontype').value = '';
        document.getElementById('filter-log-module').value = '';
        document.getElementById('filter-log-start').value = '';
        document.getElementById('filter-log-end').value = '';
        document.getElementById('filter-log-search').value = '';
        filterActionLogs();
    }

    // 5. Xem chi tiết biên lai giao dịch điện tử
    async function viewTransactionDetails(id) {
        try {
            const res = await fetch(`/Admin/GetTransactionDetails?id=${id}`);
            const data = await res.json();
            if (!data.success) {
                alert(data.message || 'Không thể tải chi tiết giao dịch.');
                return;
            }

            document.getElementById('rc-code').textContent = data.bookingCode;
            document.getElementById('rc-date').textContent = data.bookingDate;
            document.getElementById('rc-customer').textContent = data.customerName;
            document.getElementById('rc-phone').textContent = data.customerPhone;
            document.getElementById('rc-cinema').textContent = `${data.cinemaName} (${data.cinemaCity})`;
            document.getElementById('rc-cinema-address').textContent = data.cinemaAddress;
            document.getElementById('rc-movie').textContent = `${data.movieTitle} (${data.format})`;
            document.getElementById('rc-showtime').textContent = `${data.hallName} · Suất chiếu: ${data.showtime}`;
            document.getElementById('rc-seats').textContent = data.seats;
            document.getElementById('rc-payment').textContent = data.paymentMethod;
            document.getElementById('rc-verify-code').textContent = `${data.bookingCode}-SEC`;

            const badge = document.getElementById('rc-status-badge');
            badge.textContent = data.status;
            if (data.status === 'Đã thanh toán') {
                badge.style.background = '#2e7d32';
            } else if (data.status === 'Chờ xử lý') {
                badge.style.background = '#e65100';
            } else {
                badge.style.background = '#757575';
            }

            const itemsBody = document.getElementById('rc-items-body');
            itemsBody.innerHTML = '';

            // Seats row
            const seatsArray = data.seats.split('(+')[0].split(',').map(s => s.trim()).filter(Boolean);
            const ticketCount = seatsArray.length || 1;
            const singleTicketEst = (data.totalAmount - (data.foodItems ? data.foodItems.reduce((acc, cur) => acc + cur.totalPrice, 0) : 0)) / ticketCount;

            const trSeats = document.createElement('tr');
            trSeats.innerHTML = `
                <td>
                    <strong>Vé xem phim: ${data.movieTitle}</strong><br>
                    <small style="color: #666;">Ghế: ${data.seats.split('(+')[0]} · Định dạng: ${data.format}</small>
                </td>
                <td style="text-align: center;">${ticketCount}</td>
                <td style="text-align: right;">${Math.round(singleTicketEst).toLocaleString('vi-VN')} đ</td>
                <td style="text-align: right; font-weight: 700;">${Math.round(singleTicketEst * ticketCount).toLocaleString('vi-VN')} đ</td>
            `;
            itemsBody.appendChild(trSeats);

            // Food items if any
            if (data.foodItems && data.foodItems.length > 0) {
                data.foodItems.forEach(food => {
                    const trFood = document.createElement('tr');
                    trFood.innerHTML = `
                        <td>
                            <strong>🍿 ${food.name}</strong><br>
                            <small style="color: #666;">Bắp nước F&B đi kèm vé</small>
                        </td>
                        <td style="text-align: center;">${food.quantity}</td>
                        <td style="text-align: right;">${Math.round(food.unitPrice).toLocaleString('vi-VN')} đ</td>
                        <td style="text-align: right; font-weight: 700;">${Math.round(food.totalPrice).toLocaleString('vi-VN')} đ</td>
                    `;
                    itemsBody.appendChild(trFood);
                });
            }

            document.getElementById('rc-total-amount').textContent = `${Math.round(data.totalAmount).toLocaleString('vi-VN')} đ`;

            openModal('modal-receipt');
        } catch (e) {
            alert('Lỗi kết nối khi tải chi tiết giao dịch: ' + e.message);
        }
    }

    // 6. Xuất CSV danh sách giao dịch
    function exportTransactionsCSV() {
        const rows = document.querySelectorAll('.trans-row');
        const visibleRows = Array.from(rows).filter(r => r.style.display !== 'none');

        if (visibleRows.length === 0) {
            alert('Không có giao dịch nào hiển thị để xuất file.');
            return;
        }

        let csvContent = '\uFEFF'; // UTF-8 BOM
        csvContent += 'Mã Vé,Ngày Giao Dịch,Khách Hàng,Số Điện Thoại,Email,Tỉnh Thành,Cụm Rạp,Phim,Định Dạng,Ghế Đặt,Tổng Tiền (VNĐ),Cổng Thanh Toán,Trạng Thái\n';

        visibleRows.forEach(r => {
            const cols = r.querySelectorAll('td');
            const code = cols[0].querySelector('strong')?.textContent.trim() || '';
            const date = cols[0].querySelector('small')?.textContent.trim() || '';
            const name = cols[1].querySelector('strong')?.textContent.trim() || '';
            const phone = cols[1].querySelectorAll('small')[0]?.textContent.replace('📞', '').trim() || '';
            const email = cols[1].querySelectorAll('small')[1]?.textContent.replace('✉️', '').trim() || '';
            const city = r.dataset.city || '';
            const cinema = r.dataset.cinemaName || '';
            const movie = cols[3].querySelector('strong')?.textContent.trim() || '';
            const format = cols[3].querySelector('.badge')?.textContent.trim() || '2D';
            const seats = cols[4].querySelector('.badge')?.textContent.trim() || '';
            const amount = r.dataset.amount || '0';
            const payment = r.dataset.payment || '';
            const status = r.dataset.status || '';

            const rowData = [code, date, name, phone, email, city, cinema, movie, format, seats, amount, payment, status]
                .map(field => `"${(field || '').replace(/"/g, '""')}"`)
                .join(',');

            csvContent += rowData + '\n';
        });

        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.setAttribute('href', url);
        link.setAttribute('download', `CGV_GiaoDich_${new Date().toISOString().slice(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // 7. In bảng danh sách giao dịch
    function printTransactionsTable() {
        window.print();
    }
</script>
}

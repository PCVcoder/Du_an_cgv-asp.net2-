                    html += `<tr style="${h.isDeleted ? 'opacity:0.65;background:#fafafa;' : ''}">
                        <td>
                            <strong>${h.name}</strong>
                            ${h.isDeleted ? '<span class="badge" style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;font-size:0.68rem;margin-left:4px;">🔴 Đã ẩn</span>' : ''}
                        </td>
                        <td><span class="badge" style="background:${typeColor};">${h.hallType}</span></td>
                        <td><strong>${h.totalSeats}</strong> ghế <small style="color:#666;">(${h.seatsCount} ghế DB)</small></td>
                        <td><small>${h.showtimesCount} suất chiếu</small></td>
                        <td style="text-align:right;white-space:nowrap;">
                            <button type="button" class="btn-action btn-edit" onclick="openEditHallModal(${h.id})">Sửa</button>
                            ${h.isDeleted ? `
                                <form action="@Url.Action("RestoreCinemaHall", "Admin")" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="${h.id}" />
                                    <button type="submit" class="btn-action" style="background:#16a34a;color:white;">Hiện lại</button>
                                </form>
                            ` : `
                                <form action="@Url.Action("DeleteCinemaHall", "Admin")" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn ẩn phòng ${h.name}? Suất chiếu và dữ liệu ghế vẫn được lưu lại.');">

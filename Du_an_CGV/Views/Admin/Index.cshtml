                <textarea name="adminNotes" id="rental-modal-adminnotes" rows="3" placeholder="Ghi chú chi tiết trao đổi với khách, thỏa thuận cọc, bố trí phòng chiếu..." style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.85rem; font-family: inherit;"></textarea>

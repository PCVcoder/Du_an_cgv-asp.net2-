            </div>

            <div class="form-group">
                <label>Mô tả chi tiết combo / món</label>
                <textarea id="food-desc" name="Description" class="form-control" rows="2" placeholder="Chi tiết món, hương vị, thể tích nước, size bắp..."></textarea>
            </div>


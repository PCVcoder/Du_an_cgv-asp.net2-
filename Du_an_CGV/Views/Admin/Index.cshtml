    function applyCinemaFilters() {
        const searchInput = document.getElementById('cinema-search-input');
        const searchVal = (searchInput?.value || '').trim().toLowerCase();
        
        const clearBtn = document.getElementById('cinema-clear-search-btn');
        if (clearBtn) clearBtn.style.display = searchVal.length > 0 ? 'block' : 'none';

        const resetBtn = document.getElementById('cinema-reset-all-btn');
        if (resetBtn) {
            resetBtn.style.display = (searchVal.length > 0 || currentCinemaCityFilter !== 'all') ? 'inline-block' : 'none';
        }

        let visibleCount = 0;
        const rows = document.querySelectorAll('.cinema-table-row');
        rows.forEach(row => {
            const rowCity = (row.getAttribute('data-city') || '').trim().toLowerCase();
            const rowText = (row.innerText || row.textContent || '').toLowerCase();

            const matchesCity = (currentCinemaCityFilter === 'all' || rowCity === currentCinemaCityFilter.trim().toLowerCase());
            const matchesSearch = (searchVal === '' || rowText.includes(searchVal));

            if (matchesCity && matchesSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Update count display
        const countEl = document.getElementById('cinema-search-result-count');
        if (countEl) {
            countEl.innerHTML = `Hiển thị <strong>${visibleCount}</strong> / ${rows.length} rạp`;
        }

        // Show empty notification row if 0 visible
        let emptyRow = document.getElementById('cinema-no-result-row');
        if (visibleCount === 0) {
            if (!emptyRow) {
                const tbody = document.getElementById('cinemas-table-body');
                emptyRow = document.createElement('tr');
                emptyRow.id = 'cinema-no-result-row';
                emptyRow.innerHTML = `<td colspan="6" style="text-align: center; padding: 32px 16px; color: #888;">
                    <div style="font-size: 1.8rem; margin-bottom: 6px;">🔍</div>
                    <strong style="color: #333; font-size: 0.95rem;">Không tìm thấy cụm rạp nào phù hợp</strong><br/>
                    <span style="font-size: 0.8rem; color: #777;">Thử kiểm tra lại từ khóa hoặc xóa bớt bộ lọc thành phố.</span>
                </td>`;
                tbody.appendChild(emptyRow);
            }
            emptyRow.style.display = '';
        } else if (emptyRow) {
            emptyRow.style.display = 'none';
        }
    }


    // Xuất Excel CSV
    function exportRevenueReport() {
        const fromDate = document.getElementById('rep-from-date')?.value || '';
        const toDate = document.getElementById('rep-to-date')?.value || '';
        const cinemaId = document.getElementById('rep-cinema-filter')?.value || '';
        const movieId = document.getElementById('rep-movie-filter')?.value || '';

        const url = `@Url.Action("ExportRevenueReport", "Admin")?fromDate=${encodeURIComponent(fromDate)}&toDate=${encodeURIComponent(toDate)}&cinemaId=${encodeURIComponent(cinemaId)}&movieId=${encodeURIComponent(movieId)}`;
        window.location.href = url;
    }

    // In báo cáo
    function printRevenueReport() {
        document.body.classList.add('printing-revenue-report');
        window.print();
        setTimeout(() => {
            document.body.classList.remove('printing-revenue-report');
        }, 800);
    }

    // Tải dữ liệu báo cáo qua AJAX
    async function loadRevenueReport() {
        const loadingIndicator = document.getElementById('rep-loading-indicator');
        if (loadingIndicator) loadingIndicator.style.display = 'inline-flex';

        const fromDate = document.getElementById('rep-from-date')?.value || '';
        const toDate = document.getElementById('rep-to-date')?.value || '';
        const cinemaId = document.getElementById('rep-cinema-filter')?.value || '';
        const movieId = document.getElementById('rep-movie-filter')?.value || '';

        try {
            const url = `@Url.Action("GetRevenueReportData", "Admin")?fromDate=${encodeURIComponent(fromDate)}&toDate=${encodeURIComponent(toDate)}&cinemaId=${encodeURIComponent(cinemaId)}&movieId=${encodeURIComponent(movieId)}`;
            const res = await fetch(url);
            if (!res.ok) throw new Error('Không thể tải dữ liệu báo cáo');
            const data = await res.json();

            renderRevenueReport(data);
            repReportLoadedOnce = true;
        } catch (e) {
            console.error('Lỗi khi tải báo cáo doanh thu:', e);
        } finally {
            if (loadingIndicator) loadingIndicator.style.display = 'none';
        }
    }

    // Hiển thị dữ liệu lên giao diện
    function renderRevenueReport(data) {
        const emptyState = document.getElementById('rep-empty-state');
        const chartsSection = document.getElementById('rep-charts-section');
        const tablesSection = document.getElementById('rep-tables-section');

        // 3a. Luồng ngoại lệ: Không có dữ liệu
        if (!data || !data.hasData) {
            if (emptyState) emptyState.style.display = 'block';
            if (chartsSection) chartsSection.style.display = 'none';
            if (tablesSection) tablesSection.style.display = 'none';

            // Reset KPI cards
            document.getElementById('rep-kpi-total-rev').textContent = '0 đ';
            document.getElementById('rep-kpi-ticket-rev').textContent = '0 đ';
            document.getElementById('rep-kpi-ticket-share').textContent = 'Chiếm 0% tổng thu';
            document.getElementById('rep-kpi-food-rev').textContent = '0 đ';
            document.getElementById('rep-kpi-food-share').textContent = 'Chiếm 0% tổng thu';
            document.getElementById('rep-kpi-tickets-sold').textContent = '0 vé';
            document.getElementById('rep-kpi-orders-count').textContent = '0 đơn hoàn tất';
            document.getElementById('rep-kpi-occupancy').textContent = '0%';
            document.getElementById('rep-kpi-avg-order').textContent = '0 đ';

            destroyAllReportCharts();
            return;
        }

        if (emptyState) emptyState.style.display = 'none';
        if (chartsSection) chartsSection.style.display = 'block';
        if (tablesSection) tablesSection.style.display = 'block';

        const sum = data.summary;
        const totalRev = sum.totalRevenue || 0;
        const ticketRev = sum.totalTicketRevenue || 0;
        const foodRev = sum.totalFoodRevenue || 0;
        const ticketPercent = totalRev > 0 ? Math.round((ticketRev / totalRev) * 100) : 0;
        const foodPercent = totalRev > 0 ? Math.round((foodRev / totalRev) * 100) : 0;

        // Cập nhật thẻ KPI
        document.getElementById('rep-kpi-total-rev').textContent = totalRev.toLocaleString('vi-VN') + ' đ';
        document.getElementById('rep-kpi-ticket-rev').textContent = ticketRev.toLocaleString('vi-VN') + ' đ';
        document.getElementById('rep-kpi-ticket-share').textContent = `Chiếm ${ticketPercent}% tổng doanh thu`;
        document.getElementById('rep-kpi-food-rev').textContent = foodRev.toLocaleString('vi-VN') + ' đ';
        document.getElementById('rep-kpi-food-share').textContent = `Chiếm ${foodPercent}% tổng doanh thu`;
        document.getElementById('rep-kpi-tickets-sold').textContent = (sum.totalTicketsSold || 0).toLocaleString('vi-VN') + ' vé';
        document.getElementById('rep-kpi-orders-count').textContent = `${sum.totalOrders || 0} đơn đặt vé hoàn tất`;
        document.getElementById('rep-kpi-occupancy').textContent = (sum.occupancyRate || 0) + '%';
        document.getElementById('rep-kpi-avg-order').textContent = (sum.avgOrderValue || 0).toLocaleString('vi-VN') + ' đ';

        // Cập nhật số lượng trên các badge tab phụ
        document.getElementById('rep-badge-movies-count').textContent = data.byMovie ? data.byMovie.length : 0;
        document.getElementById('rep-badge-cinemas-count').textContent = data.byCinema ? data.byCinema.length : 0;
        document.getElementById('rep-badge-payments-count').textContent = data.byPayment ? data.byPayment.length : 0;
        document.getElementById('rep-badge-details-count').textContent = data.details ? data.details.length : 0;

        // Vẽ biểu đồ
        renderReportCharts(data);

        // Điền dữ liệu vào các bảng chi tiết
        renderReportTables(data);
    }

    function destroyAllReportCharts() {
        if (repChartTimeline) { repChartTimeline.destroy(); repChartTimeline = null; }
        if (repChartMix) { repChartMix.destroy(); repChartMix = null; }
        if (repChartMovies) { repChartMovies.destroy(); repChartMovies = null; }
        if (repChartCinemas) { repChartCinemas.destroy(); repChartCinemas = null; }
    }

    function renderReportCharts(data) {
        if (typeof Chart === 'undefined') {
            console.warn('Chart.js chưa được tải, bỏ qua vẽ canvas');
            return;
        }

        destroyAllReportCharts();

        // 1. Biểu đồ Diễn biến thời gian (Bar & Line kết hợp)
        const timelineCanvas = document.getElementById('rep-chart-timeline');
        if (timelineCanvas && data.timeline && data.timeline.length > 0) {
            const labels = data.timeline.map(t => t.date);
            const ticketData = data.timeline.map(t => t.ticketRevenue);
            const foodData = data.timeline.map(t => t.foodRevenue);
            const totalData = data.timeline.map(t => t.totalRevenue);

            repChartTimeline = new Chart(timelineCanvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Tổng Doanh Thu',
                            data: totalData,
                            borderColor: '#16a34a',
                            backgroundColor: 'rgba(22, 163, 74, 0.1)',
                            borderWidth: 2.5,
                            tension: 0.3,
                            fill: false,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            order: 1
                        },
                        {
                            type: 'bar',
                            label: 'Doanh Thu Vé',
                            data: ticketData,
                            backgroundColor: '#e30613',
                            borderRadius: 4,
                            order: 2
                        },
                        {
                            type: 'bar',
                            label: 'Bắp Nước F&B',
                            data: foodData,
                            backgroundColor: '#f59e0b',
                            borderRadius: 4,
                            order: 3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + (context.raw || 0).toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(val) {
                                    if (val >= 1000000) return (val / 1000000) + ' Tr';
                                    if (val >= 1000) return (val / 1000) + ' k';
                                    return val;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 2. Biểu đồ tròn Cơ cấu Doanh thu (Vé vs F&B)
        const mixCanvas = document.getElementById('rep-chart-revenue-mix');
        if (mixCanvas) {
            const ticketRev = data.summary.totalTicketRevenue || 0;
            const foodRev = data.summary.totalFoodRevenue || 0;

            repChartMix = new Chart(mixCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Doanh Thu Vé', 'Doanh Thu F&B'],
                    datasets: [{
                        data: [ticketRev, foodRev],
                        backgroundColor: ['#e30613', '#f59e0b'],
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const total = ticketRev + foodRev;
                                    const pct = total > 0 ? Math.round((context.raw / total) * 100) : 0;
                                    return `${context.label}: ${(context.raw || 0).toLocaleString('vi-VN')} đ (${pct}%)`;
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });
        }

        // 3. Biểu đồ cột ngang Top Phim Doanh Thu Cao Nhất
        const moviesCanvas = document.getElementById('rep-chart-movies');
        if (moviesCanvas && data.byMovie && data.byMovie.length > 0) {
            const topMovies = data.byMovie.slice(0, 7);
            const labels = topMovies.map(m => m.movieTitle.length > 20 ? m.movieTitle.slice(0, 18) + '...' : m.movieTitle);
            const revData = topMovies.map(m => m.totalRevenue);

            repChartMovies = new Chart(moviesCanvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh Thu (VNĐ)',
                        data: revData,
                        backgroundColor: '#dc2626',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh thu: ' + (context.raw || 0).toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(val) {
                                    if (val >= 1000000) return (val / 1000000) + ' Tr';
                                    if (val >= 1000) return (val / 1000) + ' k';
                                    return val;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 4. Biểu đồ cột Top Cụm Rạp Doanh Thu Cao Nhất
        const cinemasCanvas = document.getElementById('rep-chart-cinemas');
        if (cinemasCanvas && data.byCinema && data.byCinema.length > 0) {
            const topCinemas = data.byCinema.slice(0, 7);
            const labels = topCinemas.map(c => c.cinemaName.replace('CGV ', ''));
            const revData = topCinemas.map(c => c.totalRevenue);

            repChartCinemas = new Chart(cinemasCanvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh Thu (VNĐ)',
                        data: revData,
                        backgroundColor: '#2563eb',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh thu: ' + (context.raw || 0).toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(val) {
                                    if (val >= 1000000) return (val / 1000000) + ' Tr';
                                    if (val >= 1000) return (val / 1000) + ' k';
                                    return val;
                                }
                            }
                        }
                    }
                }
            });
        }
    }


    async function checkShowtimeConflictLive() {
        const movieId = document.getElementById('showtime-movie')?.value;
        const hallId = document.getElementById('showtime-hall')?.value;
        const startTime = document.getElementById('showtime-start')?.value;
        const showtimeId = document.getElementById('showtime-id')?.value || 0;
        const box = document.getElementById('showtime-conflict-box');
        const submitBtn = document.getElementById('showtime-submit-btn');

        if (!movieId || !hallId || !startTime) {
            if (box) box.style.display = 'none';
            if (submitBtn) submitBtn.disabled = false;
            return;
        }

        try {
            const url = `@Url.Action("CheckShowtimeConflict", "Admin")?movieId=${movieId}&cinemaHallId=${hallId}&startTime=${encodeURIComponent(startTime)}&excludeShowtimeId=${showtimeId}`;
            const res = await fetch(url);
            if (!res.ok) return;
            const data = await res.json();

            if (box) {
                box.style.display = 'block';
                if (data.hasConflict) {
                    box.style.background = '#ffebee';
                    box.style.border = '1px solid #ef9a9a';
                    box.style.color = '#c62828';
                    box.innerHTML = `<strong>⚠️ TRÙNG LỊCH CHIẾU:</strong> ${data.message}`;
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.title = 'Vui lòng đổi khung giờ hoặc phòng chiếu trước khi lưu';
                    }
                } else {
                    box.style.background = '#e8f5e9';
                    box.style.border = '1px solid #a5d6a7';
                    box.style.color = '#2e7d32';
                    box.innerHTML = `${data.message}`;
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.title = '';
                    }
                }
            }
        } catch (e) {
            console.error('Error checking showtime conflict:', e);
        }
    }


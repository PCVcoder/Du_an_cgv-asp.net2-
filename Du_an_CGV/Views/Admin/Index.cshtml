    // ==========================================================
    // CASCADING FILTER LOGIC (TỈNH -> RẠP) CHO GIAO DỊCH & THAO TÁC
    // ==========================================================
    const allCinemasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Cinemas.Select(c => new { id = c.Id, name = c.Name, city = c.City })));

    // 1. Khi chọn Tỉnh ở Lịch sử giao dịch
    function onTransCityChanged() {
        const selectedCity = document.getElementById('filter-trans-city').value;
        const cinemaSelect = document.getElementById('filter-trans-cinema');
        if (!cinemaSelect) return;

        cinemaSelect.innerHTML = '';
        if (!selectedCity) {
            cinemaSelect.innerHTML = '<option value="">-- Tất cả cụm rạp toàn quốc --</option>';
            allCinemasData.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = `${c.name} (${c.city})`;
                cinemaSelect.appendChild(opt);
            });
        } else {
            cinemaSelect.innerHTML = `<option value="">-- Tất cả cụm rạp tại ${selectedCity} --</option>`;
            const filteredCinemas = allCinemasData.filter(c => c.city === selectedCity);
            filteredCinemas.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = c.name;
                cinemaSelect.appendChild(opt);
            });
        }
        filterTransactions();
    }

    // 2. Lọc dữ liệu giao dịch real-time
    function filterTransactions() {
        const city = (document.getElementById('filter-trans-city')?.value || '').trim().toLowerCase();
        const cinemaId = (document.getElementById('filter-trans-cinema')?.value || '').trim();
        const status = (document.getElementById('filter-trans-status')?.value || '').trim();
        const payment = (document.getElementById('filter-trans-payment')?.value || '').trim();
        const startDate = document.getElementById('filter-trans-start')?.value || '';
        const endDate = document.getElementById('filter-trans-end')?.value || '';
        const search = (document.getElementById('filter-trans-search')?.value || '').trim().toLowerCase();

        const rows = document.querySelectorAll('.trans-row');
        let matched = 0;
        let totalPaidRevenue = 0;
        let paidCount = 0;
        let otherCount = 0;

        rows.forEach(row => {
            const rCity = (row.dataset.city || '').toLowerCase();
            const rCinemaId = row.dataset.cinemaId || '0';
            const rStatus = row.dataset.status || '';
            const rPayment = row.dataset.payment || '';
            const rDate = row.dataset.date || '';
            const rAmount = parseFloat(row.dataset.amount || '0');
            const rSearch = (row.dataset.search || '').toLowerCase();

            let isMatch = true;

            if (city && rCity !== city) isMatch = false;
            if (cinemaId && rCinemaId !== cinemaId) isMatch = false;
            if (status && rStatus !== status) isMatch = false;
            if (payment && rPayment !== payment) isMatch = false;
            if (startDate && rDate < startDate) isMatch = false;
            if (endDate && rDate > endDate) isMatch = false;
            if (search && !rSearch.includes(search)) isMatch = false;

            if (isMatch) {
                row.style.display = '';
                matched++;
                if (rStatus === 'Đã thanh toán') {
                    totalPaidRevenue += rAmount;
                    paidCount++;
                } else {
                    otherCount++;
                }
            } else {
                row.style.display = 'none';
            }
        });

        // Update counters & stats
        const countBadge = document.getElementById('trans-count-badge');
        if (countBadge) countBadge.textContent = `${matched} giao dịch`;
        const shownCount = document.getElementById('trans-shown-count');
        if (shownCount) shownCount.textContent = matched;

        const statTotal = document.getElementById('trans-stat-total');
        if (statTotal) statTotal.textContent = matched;

        const statRevenue = document.getElementById('trans-stat-revenue');
        if (statRevenue) statRevenue.innerHTML = `${totalPaidRevenue.toLocaleString('vi-VN')} <span style="font-size: 0.8rem;">đ</span>`;

        const statPaid = document.getElementById('trans-stat-paid');
        if (statPaid) statPaid.textContent = paidCount;

        const statOther = document.getElementById('trans-stat-other');
        if (statOther) statOther.textContent = otherCount;

        const emptyRow = document.getElementById('trans-empty-row');
        if (emptyRow) {
            emptyRow.style.display = matched === 0 ? '' : 'none';
        }
    }

    function resetTransFilter() {
        document.getElementById('filter-trans-city').value = '';
        onTransCityChanged();
        document.getElementById('filter-trans-cinema').value = '';
        document.getElementById('filter-trans-status').value = '';

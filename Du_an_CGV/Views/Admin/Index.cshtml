    function openRentalDetailModal(id, name, company, phone, email, cinema, service, guestCount, date, status, budget, notes, adminNotes, maxHall, totalCinema) {
        document.getElementById('rental-modal-id').value = id;
        document.getElementById('rental-modal-name').textContent = name || 'Chưa cung cấp';
        document.getElementById('rental-modal-company').textContent = company ? company : '(Khách hàng cá nhân)';
        document.getElementById('rental-modal-phone').textContent = phone || 'Chưa có SĐT';
        document.getElementById('rental-modal-email').textContent = email || 'Chưa có Email';
        document.getElementById('rental-modal-service').textContent = service || 'Thuê rạp / Vé nhóm';
        document.getElementById('rental-modal-guestcount').textContent = (guestCount || 0).toLocaleString('vi-VN');
        document.getElementById('rental-modal-date').textContent = date ? new Date(date).toLocaleDateString('vi-VN') : 'Chưa định ngày';
        document.getElementById('rental-modal-notes').textContent = notes || 'Không có ghi chú thêm từ khách hàng.';

        // Cinema capacity status
        document.getElementById('rental-modal-cinema').textContent = cinema || 'CGV Cinema';
        document.getElementById('rental-modal-maxhall').textContent = (maxHall || 96).toLocaleString('vi-VN');
        document.getElementById('rental-modal-totalcinema').textContent = (totalCinema || 300).toLocaleString('vi-VN');

        const isBig = (guestCount >= 50) || Boolean(company && company.trim());
        const bigBadge = document.getElementById('rental-modal-badge-big');
        if (bigBadge) {
            bigBadge.style.display = isBig ? 'inline-flex' : 'none';
        }

        const capStatusBox = document.getElementById('rental-modal-capacity-status');
        if (guestCount > totalCinema) {
            capStatusBox.innerHTML = `
                <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 4px; padding: 8px 10px; font-size: 0.78rem; color: #991b1b;">
                    <div style="font-weight: 700;">🚨 Vượt quá tổng sức chứa cả cụm rạp (${totalCinema} ghế)</div>
                    <div style="margin-top: 2px;">Cần tư vấn khách đổi sang cụm rạp có quy mô lớn hơn hoặc chia ca tổ chức.</div>
                </div>`;
        } else if (guestCount > maxHall) {
            const rooms = Math.ceil(guestCount / maxHall);
            capStatusBox.innerHTML = `
                <div style="background: #fff7ed; border: 1px solid #fed7aa; border-radius: 4px; padding: 8px 10px; font-size: 0.78rem; color: #9a3412;">
                    <div style="font-weight: 700;">⚠️ Vượt sức chứa phòng đơn lớn nhất (${maxHall} ghế)</div>
                    <div style="margin-top: 2px;">Đề xuất: Điều phối phân bổ <strong>${rooms} phòng chiếu song song</strong> hoặc tổ chức 2 ca.</div>
                </div>`;
        } else {
            capStatusBox.innerHTML = `
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 4px; padding: 8px 10px; font-size: 0.78rem; color: #166534;">
                    <div style="font-weight: 700;">✅ Phù hợp sức chứa phòng đơn</div>
                    <div style="margin-top: 2px;">Phòng lớn nhất (${maxHall} ghế) đáp ứng tốt quy mô ${guestCount} khách.</div>
                </div>`;
        }

        // Quotation Calculator
        const ticketRate = 80000;
        const comboRate = 55000;
        const techFee = (service && service.includes('Thuê trọn rạp')) ? 2000000 : 1000000;
        const totalTickets = (guestCount || 0) * ticketRate;
        const totalCombos = (guestCount || 0) * comboRate;
        const calcTotal = totalTickets + totalCombos + techFee;
        currentRentalCalculatedBudget = calcTotal;

        document.getElementById('rental-calc-tickets').textContent = totalTickets.toLocaleString('vi-VN') + ' đ';
        document.getElementById('rental-calc-combos').textContent = totalCombos.toLocaleString('vi-VN') + ' đ';
        document.getElementById('rental-calc-tech').textContent = techFee.toLocaleString('vi-VN') + ' đ';
        document.getElementById('rental-calc-total').textContent = calcTotal.toLocaleString('vi-VN') + ' đ';

        // Current status & budget & notes
        const statusSelect = document.getElementById('rental-modal-status-select');
        if (statusSelect) {
            statusSelect.value = status || 'Mới tiếp nhận';
            if (!statusSelect.value) statusSelect.value = 'Mới tiếp nhận';
        }

        const budgetInput = document.getElementById('rental-modal-budget-input');
        if (budgetInput) {
            budgetInput.value = budget > 0 ? budget : '';

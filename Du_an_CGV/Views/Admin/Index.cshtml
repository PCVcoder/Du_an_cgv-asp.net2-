                });
            } else {
                tbodyDetails.innerHTML = '<tr><td colspan="9" style="text-align:center; padding: 20px; color: #888;">Chưa có dữ liệu</td></tr>';
            }
        }
    }

    // Khởi tạo ngày mặc định cho Báo cáo khi trang sẵn sàng
    document.addEventListener('DOMContentLoaded', function() {
        const today = new Date();
        const formatDateStr = (d) => {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        };

        const fromInput = document.getElementById('rep-from-date');
        const toInput = document.getElementById('rep-to-date');
        if (fromInput && toInput && !fromInput.value && !toInput.value) {
            toInput.value = formatDateStr(today);
            const d30 = new Date();
            d30.setDate(today.getDate() - 29);
            fromInput.value = formatDateStr(d30);
        }

        @if (activeTab == "reports")
        {
            <text>
            setTimeout(loadRevenueReport, 250);
            </text>
        }
    });
</script>
}

                <div class="form-group">
                    <label>Thứ tự hiển thị</label>
                    <input type="number" id="food-sortorder" name="SortOrder" class="form-control" value="1" />
                </div>
                <div class="form-group" style="display:flex;align-items:center;margin-top:24px;">
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
                        <input type="checkbox" id="food-isavailable" name="IsAvailable" value="true" checked />
                        <span>Đang kinh doanh / Phục vụ tại quầy</span>
                    </label>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 14px;">
                <button type="button" class="btn-action" style="background:#888;color:white;padding:8px 16px;" onclick="closeModal('food-modal')">Hủy</button>
                <button type="submit" class="btn-add">Lưu Món F&B</button>
            </div>
        </form>
    </div>
</div>

<!-- ===================== MODAL THÊM / SỬA SUẤT CHIẾU ===================== -->
<div class="modal-overlay" id="showtime-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="showtime-modal-title">Thêm Suất Chiếu Mới</h3>
            <button type="button" class="modal-close" onclick="closeModal('showtime-modal')">×</button>
        </div>
        <form id="showtime-form" method="post" asp-controller="Admin" asp-action="CreateShowtime">
            @Html.AntiForgeryToken()
            <input type="hidden" id="showtime-id" name="Id" value="0" />

            <div class="form-group">
                <label>Chọn Phim *</label>
                <select id="showtime-movie" name="MovieId" class="form-control" onchange="checkShowtimeConflictLive()" required>
                    @foreach (var m in Model.Movies.Where(x => x.IsNowShowing && !x.IsUpcoming))
                    {
                        <option value="@m.Id">@m.Title (@m.Duration phút)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Chọn Cụm Rạp & Phòng Chiếu *</label>
                <select id="showtime-hall" name="CinemaHallId" class="form-control" onchange="checkShowtimeConflictLive()" required>
                    @foreach (var cin in Model.Cinemas)
                    {
                        <optgroup label="@cin.Name (@cin.City)">
                            @foreach (var hall in cin.CinemaHalls)
                            {
                                <option value="@hall.Id">@hall.Name - @hall.HallType</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label>Thời Gian Bắt Đầu *</label>
                    <input type="datetime-local" id="showtime-start" name="StartTime" class="form-control" onchange="checkShowtimeConflictLive()" oninput="checkShowtimeConflictLive()" required />
                </div>
                <div class="form-group">
                    <label>Định Dạng Chiếu *</label>
                    <select id="showtime-format" name="Format" class="form-control">
                        <option value="2D">2D Phụ Đề</option>
                        <option value="2D Lồng Tiếng">2D Lồng Tiếng</option>
                        <option value="3D">3D Digital</option>
                        <option value="IMAX">IMAX Laser</option>
                        <option value="4DX">4DX</option>
                        <option value="L'Amour">L'Amour Giường Nằm</option>
                    </select>
                </div>
            </div>

            <!-- Khối hiển thị trạng thái kiểm tra trùng lịch theo thời gian thực -->
            <div id="showtime-conflict-box" style="display:none; padding: 10px 14px; border-radius: 6px; font-size: 0.83rem; margin-bottom: 12px; line-height: 1.4;"></div>

            <div class="form-group">
                <label>Giá Vé Cơ Bản (VNĐ) *</label>
                <input type="number" id="showtime-price" name="Price" class="form-control" value="110000" step="5000" required />
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 14px;">
                <button type="button" class="btn-action" style="background:#888;color:white;padding:8px 16px;" onclick="closeModal('showtime-modal')">Hủy</button>
                <button type="submit" id="showtime-submit-btn" class="btn-add">Lưu Suất Chiếu</button>
            </div>
        </form>
    </div>
</div>

<!-- ===================== MODAL THÊM / SỬA ƯU ĐÃI ===================== -->

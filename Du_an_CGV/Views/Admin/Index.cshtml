@section Scripts {
<script>
    // @@ts-nocheck
    // Tab switching
    function switchAdminTab(tabName, el) {
        document.querySelectorAll('.admin-nav-item').forEach(item => item.classList.remove('active'));
        if (el) {
            el.classList.add('active');
        } else {
            const navBtn = Array.from(document.querySelectorAll('.admin-nav-item')).find(b => b.getAttribute('onclick')?.includes("'" + tabName + "'"));
            if (navBtn) navBtn.classList.add('active');
        }
        
        ['dashboard', 'movies', 'cinemas', 'showtimes', 'food', 'promos', 'bookings', 'transactions', 'actionlogs', 'inquiries', 'rentals'].forEach(t => {
            const elTab = document.getElementById('tab-' + t);
            if (elTab) elTab.style.display = 'none';
        });
        
        const target = document.getElementById('tab-' + tabName);
        if (target) {
            target.style.display = 'block';
        }
    }

    function openModal(id) {
        document.getElementById(id).classList.add('active');
    }

    function closeModal(id) {
        document.getElementById(id).classList.remove('active');
    }

    // Movies Modal logic
    function syncMovieStatusRadio(val) {
        const isNow = (val === 'now-showing');
        const isUp = (val === 'upcoming');
        const elNow = document.getElementById('movie-isnowshowing');
        const elUp = document.getElementById('movie-isupcoming');
        if (elNow) elNow.value = isNow ? 'true' : 'false';
        if (elUp) elUp.value = isUp ? 'true' : 'false';
    }

    function openCreateMovieModal() {
        document.getElementById('movie-modal-title').textContent = 'Thêm Phim Mới';
        document.getElementById('movie-form').action = '@Url.Action("CreateMovie", "Admin")';
        document.getElementById('movie-id').value = '0';
        document.getElementById('movie-title').value = '';
        document.getElementById('movie-genre').value = '';
        document.getElementById('movie-duration').value = '120';
        document.getElementById('movie-releasedate').value = new Date().toISOString().split('T')[0];
        document.getElementById('movie-poster').value = 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=400';
        document.getElementById('movie-director').value = '';
        document.getElementById('movie-cast').value = '';
        document.getElementById('movie-synopsis').value = '';
        const radioNow = document.getElementById('movie-status-nowshowing');
        if (radioNow) radioNow.checked = true;
        syncMovieStatusRadio('now-showing');
        openModal('movie-modal');
    }

    async function openEditMovieModal(id) {
        try {
            const res = await fetch('@Url.Action("GetMovie", "Admin")?id=' + id);
            if (!res.ok) throw new Error('Không thể tải thông tin phim');
            const data = await res.json();

            document.getElementById('movie-modal-title').textContent = 'Sửa Phim: ' + data.title;
            document.getElementById('movie-form').action = '@Url.Action("EditMovie", "Admin")';
            document.getElementById('movie-id').value = data.id;
            document.getElementById('movie-title').value = data.title || '';
            document.getElementById('movie-genre').value = data.genre || '';
            document.getElementById('movie-duration').value = data.duration || 120;
            document.getElementById('movie-rating').value = data.rating || 'T16';
            if (data.releaseDate) {
                document.getElementById('movie-releasedate').value = data.releaseDate.split('T')[0];
            }
            document.getElementById('movie-poster').value = data.posterUrl || '';
            document.getElementById('movie-director').value = data.director || '';
            document.getElementById('movie-formats').value = data.formats || '2D DIGITAL';
            document.getElementById('movie-cast').value = data.cast || '';
            document.getElementById('movie-synopsis').value = data.synopsis || '';
            
            if (data.isNowShowing) {
                const r = document.getElementById('movie-status-nowshowing');
                if (r) r.checked = true;
                syncMovieStatusRadio('now-showing');
            } else if (data.isUpcoming) {
                const r = document.getElementById('movie-status-upcoming');
                if (r) r.checked = true;
                syncMovieStatusRadio('upcoming');
            } else {
                const r = document.getElementById('movie-status-ended');
                if (r) r.checked = true;
                syncMovieStatusRadio('ended');
            }

            openModal('movie-modal');
        } catch (e) {
            alert('Lỗi tải dữ liệu phim: ' + e.message);
        }
    }

    // Movie Filter by Status
    function filterMoviesByStatus(status, btn) {
        document.querySelectorAll('.admin-movie-pill').forEach(b => {
            b.style.background = '#f8f9fa';
            b.style.color = '#333';
            b.style.border = '1px solid #ddd';
            b.classList.remove('active');
        });
        if (btn) {
            btn.style.background = status === 'now-showing' ? '#2e7d32' : (status === 'upcoming' ? '#1565c0' : (status === 'ended' ? '#616161' : '#e30613'));
            btn.style.color = 'white';
            btn.style.border = 'none';
            btn.classList.add('active');
        }
        document.querySelectorAll('.admin-movie-row').forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            if (status === 'all' || rowStatus === status) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Cinema Filter & Search logic
    let currentCinemaCityFilter = 'all';

    function filterCinemasByCity(city, btn) {
        currentCinemaCityFilter = city;
        document.querySelectorAll('.admin-city-pill').forEach(b => {
            b.style.background = '#f8f9fa';
            b.style.color = '#333';
            b.style.border = '1px solid #ddd';
            b.classList.remove('active');
        });
        if (btn) {
            btn.style.background = '#e30613';
            btn.style.color = 'white';
            btn.style.border = 'none';
            btn.classList.add('active');
        }
        applyCinemaFilters();
    }

    function searchCinemas() {
        applyCinemaFilters();
    }

    function clearCinemaSearch() {
        const input = document.getElementById('cinema-search-input');
        if (input) {
            input.value = '';
            input.focus();
        }
        applyCinemaFilters();
    }

    function resetAllCinemaFilters() {
        currentCinemaCityFilter = 'all';
        const input = document.getElementById('cinema-search-input');
        if (input) input.value = '';
        
        document.querySelectorAll('.admin-city-pill').forEach((b, idx) => {
            if (idx === 0) {
                b.style.background = '#e30613';
                b.style.color = 'white';
                b.style.border = 'none';
                b.classList.add('active');
            } else {
                b.style.background = '#f8f9fa';
                b.style.color = '#333';
                b.style.border = '1px solid #ddd';
                b.classList.remove('active');
            }
        });
        applyCinemaFilters();
    }

    function applyCinemaFilters() {
        const searchInput = document.getElementById('cinema-search-input');
        const searchVal = (searchInput?.value || '').trim().toLowerCase();
        
        const clearBtn = document.getElementById('cinema-clear-search-btn');
        if (clearBtn) clearBtn.style.display = searchVal.length > 0 ? 'block' : 'none';

        const resetBtn = document.getElementById('cinema-reset-all-btn');
        if (resetBtn) {
            resetBtn.style.display = (searchVal.length > 0 || currentCinemaCityFilter !== 'all') ? 'inline-block' : 'none';
        }

        let visibleCount = 0;
        const rows = document.querySelectorAll('.cinema-table-row');
        rows.forEach(row => {
            const rowCity = (row.getAttribute('data-city') || '').trim().toLowerCase();
            const rowText = (row.innerText || row.textContent || '').toLowerCase();

            const matchesCity = (currentCinemaCityFilter === 'all' || rowCity === currentCinemaCityFilter.trim().toLowerCase());
            const matchesSearch = (searchVal === '' || rowText.includes(searchVal));

            if (matchesCity && matchesSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Update count display
        const countEl = document.getElementById('cinema-search-result-count');
        if (countEl) {
            countEl.innerHTML = `Hiển thị <strong>${visibleCount}</strong> / ${rows.length} rạp`;
        }

        // Show empty notification row if 0 visible
        let emptyRow = document.getElementById('cinema-no-result-row');
        if (visibleCount === 0) {
            if (!emptyRow) {
                const tbody = document.getElementById('cinemas-table-body');
                emptyRow = document.createElement('tr');
                emptyRow.id = 'cinema-no-result-row';
                emptyRow.innerHTML = `<td colspan="6" style="text-align: center; padding: 32px 16px; color: #888;">
                    <div style="font-size: 1.8rem; margin-bottom: 6px;">🔍</div>
                    <strong style="color: #333; font-size: 0.95rem;">Không tìm thấy cụm rạp nào phù hợp</strong><br/>
                    <span style="font-size: 0.8rem; color: #777;">Thử kiểm tra lại từ khóa hoặc xóa bớt bộ lọc thành phố.</span>
                </td>`;
                tbody.appendChild(emptyRow);
            }
            emptyRow.style.display = '';
        } else if (emptyRow) {
            emptyRow.style.display = 'none';
        }
    }

    function openCreateCinemaModal() {
        document.getElementById('cinema-modal-title').textContent = 'Thêm Rạp CGV Mới';
        document.getElementById('cinema-form').action = '@Url.Action("CreateCinema", "Admin")';
        document.getElementById('cinema-id').value = '0';
        document.getElementById('cinema-name').value = '';
        document.getElementById('cinema-city').value = 'Hồ Chí Minh';
        document.getElementById('cinema-address').value = '';
        document.getElementById('cinema-hotline').value = '1900 6017';
        document.getElementById('cinema-image').value = '';
        document.getElementById('cinema-desc').value = '';
        const hallsGroup = document.getElementById('cinema-halls-group');
        if (hallsGroup) hallsGroup.style.display = 'block';
        openModal('cinema-modal');
    }

    async function openEditCinemaModal(id) {
        try {
            const res = await fetch('@Url.Action("GetCinema", "Admin")?id=' + id);
            if (!res.ok) throw new Error('Không thể tải dữ liệu rạp');
            const data = await res.json();

            document.getElementById('cinema-modal-title').textContent = 'Sửa Rạp: ' + data.name;
            document.getElementById('cinema-form').action = '@Url.Action("EditCinema", "Admin")';
            document.getElementById('cinema-id').value = data.id;
            document.getElementById('cinema-name').value = data.name || '';
            document.getElementById('cinema-city').value = data.city || 'Hồ Chí Minh';
            document.getElementById('cinema-address').value = data.address || '';
            document.getElementById('cinema-hotline').value = data.hotline || '1900 6017';
            document.getElementById('cinema-image').value = data.imageUrl || '';
            document.getElementById('cinema-desc').value = data.description || '';
            const hallsGroup = document.getElementById('cinema-halls-group');
            if (hallsGroup) hallsGroup.style.display = 'none';

            openModal('cinema-modal');
        } catch (e) {
            alert('Lỗi: ' + e.message);
        }
    }

    // Cinema Halls Management Logic (CRUD Phòng Chiếu)
    async function openManageHallsModal(cinemaId, cinemaName) {
        document.getElementById('halls-modal-subtitle').textContent = 'Cụm rạp: ' + (cinemaName || 'CGV');
        document.getElementById('quick-adjust-cinema-id').value = cinemaId;
        document.getElementById('add-hall-cinema-id').value = cinemaId;
        document.getElementById('halls-table-body').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;">Đang tải danh sách phòng chiếu...</td></tr>';
        openModal('halls-modal');

        try {
            const res = await fetch('@Url.Action("GetCinemaHalls", "Admin")?cinemaId=' + cinemaId);
            if (!res.ok) throw new Error('Không thể tải danh sách phòng chiếu');
            const data = await res.json();

            document.getElementById('halls-modal-title').textContent = `Quản Lý Phòng Chiếu (${data.halls.length} phòng)`;
            document.getElementById('quick-adjust-count').value = data.halls.length > 0 ? (data.halls.length <= 12 ? data.halls.length : 12) : 3;

            if (data.halls.length === 0) {
                document.getElementById('halls-table-body').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#e65100;padding:20px;">Rạp này hiện chưa có phòng chiếu nào. Hãy thêm phòng bên dưới hoặc chọn điều chỉnh nhanh!</td></tr>';
            } else {
                let html = '';
                data.halls.forEach(h => {
                    const typeColor = h.hallType.includes('IMAX') ? '#b71c1c' : (h.hallType.includes('L\'Amour') ? '#ad1457' : (h.hallType.includes('3D') ? '#0288d1' : '#455a64'));
                    html += `<tr>
                        <td><strong>${h.name}</strong></td>
                        <td><span class="badge" style="background:${typeColor};">${h.hallType}</span></td>
                        <td><strong>${h.totalSeats}</strong> ghế <small style="color:#666;">(${h.seatsCount} ghế DB)</small></td>
                        <td><small>${h.showtimesCount} suất chiếu</small></td>
                        <td style="text-align:right;white-space:nowrap;">
                            <button type="button" class="btn-action btn-edit" onclick="openEditHallModal(${h.id})">Sửa</button>
                            <form action="@Url.Action("DeleteCinemaHall", "Admin")" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa phòng ${h.name}? Toàn bộ ghế và suất chiếu của phòng sẽ bị xóa!');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="${h.id}" />
                                <button type="submit" class="btn-action btn-del">Xóa</button>
                            </form>
                        </td>
                    </tr>`;
                });
                document.getElementById('halls-table-body').innerHTML = html;
            }

            // Set suggested name for new hall
            document.getElementById('add-hall-name').value = `Cinema ${(data.halls.length + 1).toString().padStart(2, '0')}`;
        } catch (e) {
            document.getElementById('halls-table-body').innerHTML = `<tr><td colspan="5" style="text-align:center;color:red;padding:20px;">Lỗi: ${e.message}</td></tr>`;
        }
    }


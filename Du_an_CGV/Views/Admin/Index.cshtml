<div class="modal-overlay" id="movie-modal">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="movie-modal-title">Thêm Phim Mới</h3>
            <button type="button" class="modal-close" onclick="closeModal('movie-modal')">×</button>
        </div>
        <form id="movie-form" method="post" asp-controller="Admin" asp-action="CreateMovie">
            @Html.AntiForgeryToken()
            <input type="hidden" id="movie-id" name="Id" value="0" />

            <div class="form-group">
                <label>Tên phim *</label>
                <input type="text" id="movie-title" name="Title" class="form-control" placeholder="Nhập tên phim" required />
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label>Thể loại *</label>

        <form asp-controller="Admin" asp-action="UpdateRentalDetails" method="post" id="form-rental-details">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="rental-modal-id" />

            <!-- Grid 2 Cột: Thông tin khách & Khảo sát năng lực rạp -->

    async function openEditShowtimeModal(id) {
        try {
            const res = await fetch('@Url.Action("GetShowtime", "Admin")?id=' + id);
            if (!res.ok) throw new Error('Không tìm thấy suất chiếu');
            const data = await res.json();

            document.getElementById('showtime-modal-title').textContent = 'Sửa Suất Chiếu #' + data.id;
            document.getElementById('showtime-form').action = '@Url.Action("EditShowtime", "Admin")';
            document.getElementById('showtime-id').value = data.id;
            document.getElementById('showtime-movie').value = data.movieId;
            document.getElementById('showtime-hall').value = data.cinemaHallId;
            document.getElementById('showtime-start').value = data.startTime;

            // Khớp định dạng chiếu hoặc tự động thêm nếu chưa có trong danh sách
            const formatSelect = document.getElementById('showtime-format');
            if (formatSelect) {
                let found = false;
                for (let i = 0; i < formatSelect.options.length; i++) {
                    if (formatSelect.options[i].value.toLowerCase() === (data.format || '').toLowerCase()) {
                        formatSelect.selectedIndex = i;
                        found = true;
                        break;
                    }
                }
                if (!found && data.format) {
                    const opt = new Option(data.format, data.format, true, true);
                    formatSelect.add(opt);
                }
            }

            document.getElementById('showtime-price').value = data.price;

            const conflictBox = document.getElementById('showtime-conflict-box');
            if (conflictBox) conflictBox.style.display = 'none';
            const submitBtn = document.getElementById('showtime-submit-btn');
            if (submitBtn) submitBtn.disabled = false;

            openModal('showtime-modal');
            setTimeout(checkShowtimeConflictLive, 200);
        } catch (e) {
            alert('Lỗi: ' + e.message);
        }
    }


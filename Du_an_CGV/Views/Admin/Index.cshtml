    // Showtime Filter, Search & Conflict Prevention logic
    let filterOnlyConflict = false;

    function applyShowtimeFilters() {
        const searchVal = (document.getElementById('showtime-search-input')?.value || '').trim().toLowerCase();
        const movieFilter = (document.getElementById('filter-showtime-movie')?.value || 'all').trim();
        const cinemaFilter = (document.getElementById('filter-showtime-cinema')?.value || 'all').trim();
        const dateFilter = (document.getElementById('filter-showtime-date')?.value || '').trim();
        const formatFilter = (document.getElementById('filter-showtime-format')?.value || 'all').trim();

        const clearBtn = document.getElementById('showtime-clear-search-btn');
        if (clearBtn) clearBtn.style.display = searchVal.length > 0 ? 'block' : 'none';

        const hasActiveFilters = (searchVal !== '' || movieFilter !== 'all' || cinemaFilter !== 'all' || dateFilter !== '' || formatFilter !== 'all' || filterOnlyConflict);
        const resetBtn = document.getElementById('showtime-reset-all-btn');
        if (resetBtn) resetBtn.style.display = hasActiveFilters ? 'inline-block' : 'none';

        let visibleCount = 0;
        const rows = document.querySelectorAll('.showtime-table-row');
        rows.forEach(row => {
            const rowMovie = (row.getAttribute('data-movie') || '').trim();
            const rowCinema = (row.getAttribute('data-cinema') || '').trim();
            const rowDate = (row.getAttribute('data-date') || '').trim();
            const rowFormat = (row.getAttribute('data-format') || '').trim();
            const rowConflict = (row.getAttribute('data-conflict') || 'false') === 'true';
            const rowText = (row.innerText || row.textContent || '').toLowerCase();

            const matchesSearch = (searchVal === '' || rowText.includes(searchVal));
            const matchesMovie = (movieFilter === 'all' || rowMovie === movieFilter);
            const matchesCinema = (cinemaFilter === 'all' || rowCinema === cinemaFilter);
            const matchesDate = (dateFilter === '' || rowDate === dateFilter);
            const matchesFormat = (formatFilter === 'all' || rowFormat.toLowerCase().includes(formatFilter.toLowerCase()));
            const matchesConflict = (!filterOnlyConflict || rowConflict);

            if (matchesSearch && matchesMovie && matchesCinema && matchesDate && matchesFormat && matchesConflict) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const countEl = document.getElementById('showtime-count-display');
        if (countEl) {
            countEl.innerHTML = `Hiển thị <strong>${visibleCount}</strong> / ${rows.length} suất`;
        }

        let emptyRow = document.getElementById('showtime-no-result-row');
        if (visibleCount === 0) {
            if (!emptyRow) {
                const tbody = document.getElementById('showtimes-table-body');
                emptyRow = document.createElement('tr');
                emptyRow.id = 'showtime-no-result-row';
                emptyRow.innerHTML = `<td colspan="7" style="text-align: center; padding: 32px 16px; color: #888;">
                    <div style="font-size: 1.8rem; margin-bottom: 6px;">🎬</div>
                    <strong style="color: #333; font-size: 0.95rem;">Không tìm thấy suất chiếu nào phù hợp</strong><br/>
                    <span style="font-size: 0.8rem; color: #777;">Hãy thử tìm kiếm với từ khóa khác hoặc xóa bớt tiêu chí lọc.</span>
                </td>`;
                tbody.appendChild(emptyRow);
            }
            emptyRow.style.display = '';
        } else if (emptyRow) {
            emptyRow.style.display = 'none';
        }
    }


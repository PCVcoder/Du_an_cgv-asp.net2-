<!-- ===================== MODAL QUẢN LÝ PHÒNG CHIẾU CỦA RẠP (CRUD PHÒNG) ===================== -->
<div class="modal-overlay" id="halls-modal">
    <div class="modal-box" style="max-width: 840px;">
        <div class="modal-header">
            <div>
                <h3 id="halls-modal-title" style="margin: 0; font-family: 'Montserrat', sans-serif; font-size: 1.15rem; font-weight: 800; color: #111;">Quản Lý Phòng Chiếu</h3>
                <p id="halls-modal-subtitle" style="margin: 4px 0 0; font-size: 0.8rem; color: #666;">Rạp: CGV</p>
            </div>
            <button type="button" class="modal-close" onclick="closeModal('halls-modal')">×</button>
        </div>

        <!-- Điều chỉnh nhanh tổng số phòng -->
        <div style="background: #fdfaf5; border: 1px solid #ebdccb; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div>
                <strong style="font-size: 0.82rem; color: #333;">⚙️ Điều chỉnh nhanh tổng số phòng:</strong>
                <span style="font-size: 0.78rem; color: #777; margin-left: 6px;">(Hệ thống tự động thêm/bớt phòng tương ứng)</span>
            </div>
            <form asp-controller="Admin" asp-action="QuickAdjustHallCount" method="post" style="display: flex; align-items: center; gap: 8px; margin: 0;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="quick-adjust-cinema-id" name="cinemaId" value="0" />
                <select id="quick-adjust-count" name="targetCount" class="form-control" style="width: 140px; padding: 6px 10px; font-size: 0.82rem;">
                    <option value="1">1 phòng</option>
                    <option value="2">2 phòng</option>
                    <option value="3">3 phòng</option>
                    <option value="4">4 phòng</option>
                    <option value="5">5 phòng</option>
                    <option value="6">6 phòng</option>
                    <option value="7">7 phòng</option>
                    <option value="8">8 phòng</option>
                    <option value="10">10 phòng</option>
                    <option value="12">12 phòng</option>
                </select>
                <button type="submit" class="btn-action" style="background: #2e7d32; color: white; padding: 7px 14px; font-weight: 700;">Áp dụng</button>
            </form>
        </div>

        <!-- Danh sách phòng hiện có -->
        <p style="font-size: 0.82rem; font-weight: 700; margin: 0 0 8px; color: #333;">Danh sách các phòng chiếu hiện có:</p>
        <div style="max-height: 260px; overflow-y: auto; border: 1px solid #eee; border-radius: 6px; margin-bottom: 20px;">
            <table class="admin-table" style="box-shadow: none; margin: 0;">
                <thead>
                    <tr>
                        <th>Tên Phòng</th>
                        <th>Loại Phòng Chiếu</th>
                        <th>Sức Chứa Ghế</th>
                        <th>Suất Chiếu</th>
                        <th style="text-align: right; width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="halls-table-body">
                    <tr><td colspan="5" style="text-align: center; color: #888; padding: 20px;">Đang tải danh sách phòng...</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Form: Thêm phòng chiếu mới -->
        <div style="background: #f5f0e8; border-radius: 6px; padding: 16px; border: 1px solid #e0d8ca;">
            <h4 style="margin: 0 0 12px; font-size: 0.88rem; font-weight: 800; color: #222; display: flex; align-items: center; gap: 6px;">
                <span>＋</span> Thêm Phòng Chiếu Mới Cho Cụm Rạp Này
            </h4>
            <form asp-controller="Admin" asp-action="CreateCinemaHall" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="add-hall-cinema-id" name="cinemaId" value="0" />
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 10px; align-items: flex-end;">
                    <div class="form-group" style="margin: 0;">
                        <label>Tên phòng chiếu *</label>
                        <input type="text" id="add-hall-name" name="name" class="form-control" placeholder="VD: Cinema 05" required />
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label>Loại công nghệ *</label>
                        <select name="hallType" class="form-control">
                            <option value="Standard 2D">Standard 2D</option>
                            <option value="3D Atmos">3D Atmos</option>
                            <option value="IMAX Laser">IMAX Laser</option>
                            <option value="4DX">4DX Trải Nghiệm</option>
                            <option value="Gold Class">Gold Class Sang Trọng</option>
                            <option value="L'Amour Giường Nằm">L'Amour Giường Nằm</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label>Tổng số ghế *</label>
                        <input type="number" name="totalSeats" class="form-control" value="60" min="12" max="240" required />
                    </div>
                    <button type="submit" class="btn-add" style="height: 38px; white-space: nowrap;">Thêm Phòng</button>
                </div>
            </form>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
            <button type="button" class="btn-action" style="background:#555;color:white;padding:8px 18px;" onclick="closeModal('halls-modal')">Đóng</button>
        </div>
    </div>
</div>


@{
    ViewData["Title"] = "CGV - Hệ Thống Quản Trị Hệ Thống";
}

@section Styles {
<style>
    .admin-wrapper {
        display: flex;
        min-height: 680px;
        background: #f5f0e8;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        margin: 20px auto 50px;
        max-width: 1100px;
        border: 1px solid #dfd8cf;
    }
    
    /* Sidebar */
    .admin-aside {
        width: 230px;
        background: #1a1a1a;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }
    .admin-sidebar-header {
        padding: 22px 20px 18px;
        border-bottom: 1px solid #333;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .admin-sidebar-header .logo {
        font-family: 'Oswald', sans-serif;
        font-weight: 700;
        color: #e30613;
        font-size: 1.5rem;
    }
    .admin-sidebar-header .role {
        color: #888;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1px;
    }
    
    .admin-nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 13px 20px;
        background: transparent;
        color: #ccc;
        font-weight: 500;
        font-size: 0.88rem;
        border: none;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }
    .admin-nav-item:hover { background: rgba(255,255,255,0.08); color: white; }
    .admin-nav-item.active { background: #e30613; color: white; font-weight: 700; }
    
    /* Main Content */
    .admin-main {
        flex: 1;
        background: #f5f0e8;
        overflow-x: auto;
        padding: 28px 32px 40px;
    }
    .admin-title {
        font-family: 'Montserrat', 'Roboto', sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 0 24px;
        color: #111;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    
    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }
    .stat-card {
        background: white;
        border-radius: 6px;
        padding: 18px 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-left: 4px solid #000;
    }
    .stat-icon { font-size: 1.6rem; margin-bottom: 6px; }
    .stat-value {
        font-size: 1.8rem;
        font-weight: 800;
        font-family: 'Montserrat', 'Roboto', sans-serif;
    }
    .stat-label { font-size: 0.8rem; color: #666; margin-top: 4px; font-weight: 500; }
    
    /* Lists */
    .list-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    .list-card {
        background: white;
        border-radius: 6px;
        padding: 20px 22px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .list-card h3 {
        font-family: 'Montserrat', 'Roboto', sans-serif;
        font-size: 1rem;
        font-weight: 800;
        margin: 0 0 16px;
        color: #111;
        border-bottom: 1px solid #f0eae1;
        padding-bottom: 8px;
    }
    .list-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #f5f0e8;
    }
    .list-item img {
        width: 40px;
        height: 56px;
        object-fit: cover;
        border-radius: 3px;
        flex-shrink: 0;
    }
    .list-item-content { flex: 1; min-width: 0; }
    .list-item-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #111;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .list-item-sub { font-size: 0.75rem; color: #777; margin-top: 2px; }
    .badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 7px;
        color: white;
        border-radius: 3px;
        flex-shrink: 0;
    }
    
    /* Tables */
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        font-size: 0.85rem;
    }
    .admin-table th {
        background: #ede6dc;
        padding: 12px 14px;
        text-align: left;
        font-weight: 700;
        color: #333;
    }
    .admin-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #f2eee8;
        vertical-align: middle;
    }
    .admin-table tr:hover { background: #faf8f5; }
    .btn-action {
        padding: 4px 10px;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 3px;
        border: none;
        cursor: pointer;
    }
    .btn-edit { background: #1565c0; color: white; }
    .btn-del { background: #d32f2f; color: white; }
    .btn-add { background: #2e7d32; color: white; padding: 8px 16px; font-weight: 700; border-radius: 4px; border: none; font-size: 0.82rem; cursor: pointer; }
</style>
}


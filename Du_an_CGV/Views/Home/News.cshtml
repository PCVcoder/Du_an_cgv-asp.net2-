@{
    ViewData["Title"] = "Tin Mới & Ưu Đãi Điện Ảnh";
}

@section Styles {
<style>
    .container { max-width: 1100px; margin: 0 auto; padding: 36px 16px 0; min-height: 80vh; }
    
    .page-title-row { display: flex; align-items: center; gap: 16px; margin-bottom: 8px; }
    .page-line { flex: 1; height: 2px; background: #333; }
    .page-title {
        font-family: 'Montserrat', 'Roboto', sans-serif; font-weight: 800; font-size: clamp(1.6rem, 4vw, 2.2rem);
        letter-spacing: 1px; color: #111; margin: 0; white-space: nowrap;
    }

    .filter-tabs { display: flex; justify-content: center; margin: 24px 0 32px; flex-wrap: wrap; }
    .filter-tab {
        padding: 10px 24px; font-weight: 700; font-size: 0.88rem; background: white; color: #333;
        border: 1px solid #ccc; border-right: none; transition: background 0.15s, color 0.15s; letter-spacing: 0.3px; cursor: pointer;
    }
    .filter-tab:hover { color: #e30613; }
    .filter-tab.active { background: #e30613; color: white; border-color: #e30613; }
    .filter-tab:first-child { border-radius: 3px 0 0 3px; }
    .filter-tab:last-child { border-radius: 0 3px 3px 0; border-right: 1px solid #ccc; }

    .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; padding-bottom: 48px; }
    
    .news-card {
        background: white; border-radius: 6px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; color: inherit; display: flex; flex-direction: column;
    }
    .news-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
    .news-card:hover img { transform: scale(1.05); }
    
    .image-wrap { position: relative; aspect-ratio: 1/1; overflow: hidden; }
    .image-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    
    .category-badge {
        position: absolute; top: 10px; left: 10px; color: white; font-weight: 800;
        font-size: 0.62rem; padding: 3px 8px; border-radius: 2px; letter-spacing: 0.5px;
    }
    
    .news-info { padding: 14px 16px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .date { display: flex; align-items: center; gap: 6px; color: #e30613; font-size: 0.75rem; font-weight: 700; }
    .news-title {
        margin: 8px 0 0; font-size: 0.88rem; font-weight: 700; color: #1a1a1a;
        line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
</style>
}

<main class="container">
    <div class="page-title-row">
        <div class="page-line"></div>
        <h1 class="page-title">TIN MỚI & ƯU ĐÃI</h1>
        <div class="page-line"></div>
    </div>

    <div class="filter-tabs">
        <button class="filter-tab active" type="button">TẤT CẢ</button>
        <button class="filter-tab" type="button">CGV MEMBERS</button>
        <button class="filter-tab" type="button">ƯU ĐÃI ĐỐI TÁC</button>
        <button class="filter-tab" type="button">SỰ KIỆN ĐIỆN ẢNH</button>
    </div>

    <div class="news-grid">
        <!-- News Card 1 -->
        <a href="#" class="news-card">
            <div class="image-wrap">
                <img src="https://images.unsplash.com/photo-1608170825938-a8ea0305d46c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="News 1">
                <span class="category-badge" style="background: #e30613;">CGV MEMBER</span>
            </div>
            <div class="news-info">
                <div class="date">📅 14/10/2026 - 31/10/2026</div>
                <h3 class="news-title">ĐỒNG GIÁ 79.000Đ DÀNH CHO KHÁCH HÀNG THÀNH VIÊN VÀO MỖI THỨ TƯ HÀNG TUẦN</h3>
            </div>
        </a>

        <!-- News Card 2 -->
        <a href="#" class="news-card">
            <div class="image-wrap">
                <img src="https://images.unsplash.com/photo-1485095329183-d0797cdc5676?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="News 2">
                <span class="category-badge" style="background: #e65100;">KHUYẾN MÃI</span>
            </div>
            <div class="news-info">
                <div class="date">📅 10/10/2026 - 25/10/2026</div>
                <h3 class="news-title">ONLINE COMBO SIÊU TIẾT KIỆM - MUA TRƯỚC VÉ & BẮP NƯỚC GIẢM ĐẾN 30%</h3>
            </div>
        </a>

        <!-- News Card 3 -->
        <a href="#" class="news-card">
            <div class="image-wrap">
                <img src="https://images.unsplash.com/photo-1688678004647-945d5aaf91c1?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="News 3">
                <span class="category-badge" style="background: #1565c0;">ĐỐI TÁC</span>
            </div>
            <div class="news-info">
                <div class="date">📅 01/10/2026 - 30/11/2026</div>
                <h3 class="news-title">GIẢM NGAY 50.000Đ KHI THANH TOÁN VÉ XEM PHIM BẰNG THẺ NGÂN HÀNG HOẶC VÍ ĐIỆN TỬ</h3>
            </div>
        </a>

        <!-- News Card 4 -->
        <a href="#" class="news-card">
            <div class="image-wrap">
                <img src="https://images.unsplash.com/photo-1534447677768-be436bb09401?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="News 4">
                <span class="category-badge" style="background: #2e7d32;">SỰ KIỆN</span>
            </div>
            <div class="news-info">
                <div class="date">📅 15/10/2026 - 20/10/2026</div>
                <h3 class="news-title">GẶP GỠ DÀN SAO ĐIỆN ẢNH VÀ GIAO LƯU FAN TẠI CGV LANDMARK 81 CUỐI TUẦN NÀY</h3>
            </div>
        </a>
    </div>
</main>

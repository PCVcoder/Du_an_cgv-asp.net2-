@model List<Du_an_CGV.Models.NewsOffer>
@{
    ViewData["Title"] = "Tin Mới & Ưu Đãi Điện Ảnh - CGV";
    var activeCategory = (string?)ViewBag.ActiveCategory ?? "all";
}

@section Styles {
<style>
    .container { max-width: 1100px; margin: 0 auto; padding: 36px 16px 0; min-height: 80vh; }
    
    .page-title-row { display: flex; align-items: center; gap: 16px; margin-bottom: 8px; }
    .page-line { flex: 1; height: 2px; background: #333; }
    .page-title {
        font-family: 'Montserrat', 'Roboto', sans-serif; font-weight: 800; font-size: clamp(1.6rem, 4vw, 2.2rem);
        letter-spacing: 1px; color: #111; margin: 0; white-space: nowrap;
    }

    .filter-tabs { display: flex; justify-content: center; margin: 24px 0 32px; flex-wrap: wrap; }
    .filter-tab {
        padding: 10px 24px; font-weight: 700; font-size: 0.88rem; background: white; color: #333;
        border: 1px solid #ccc; border-right: none; transition: background 0.15s, color 0.15s; letter-spacing: 0.3px; cursor: pointer; text-decoration: none;
    }
    .filter-tab:hover { color: #e30613; }
    .filter-tab.active { background: #e30613; color: white !important; border-color: #e30613; }
    .filter-tab:first-child { border-radius: 3px 0 0 3px; }
    .filter-tab:last-child { border-radius: 0 3px 3px 0; border-right: 1px solid #ccc; }

    .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; padding-bottom: 48px; }
    
    .news-card {
        background: white; border-radius: 6px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; color: inherit; display: flex; flex-direction: column;
    }
    .news-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
    .news-card:hover img { transform: scale(1.05); }
    
    .image-wrap { position: relative; aspect-ratio: 1/1; overflow: hidden; }
    .image-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    
    .category-badge {
        position: absolute; top: 10px; left: 10px; color: white; font-weight: 800;
        font-size: 0.62rem; padding: 3px 8px; border-radius: 2px; letter-spacing: 0.5px;
    }
    
    .news-info { padding: 14px 16px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .date { display: flex; align-items: center; gap: 6px; color: #e30613; font-size: 0.75rem; font-weight: 700; }
    .news-title {
        margin: 8px 0 0; font-size: 0.88rem; font-weight: 700; color: #1a1a1a;
        line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
</style>
}

<main class="container">
    <div class="page-title-row">
        <div class="page-line"></div>
        <h1 class="page-title">TIN MỚI & ƯU ĐÃI</h1>
        <div class="page-line"></div>
    </div>

    <div class="filter-tabs">
        <a asp-controller="Home" asp-action="News" asp-route-category="all" class="filter-tab @(activeCategory == "all" ? "active" : "")">TẤT CẢ</a>
        <a asp-controller="Home" asp-action="News" asp-route-category="offers" class="filter-tab @(activeCategory == "offers" ? "active" : "")">ƯU ĐÃI</a>
        <a asp-controller="Home" asp-action="News" asp-route-category="member" class="filter-tab @(activeCategory == "member" ? "active" : "")">CGV MEMBERS</a>
        <a asp-controller="Home" asp-action="News" asp-route-category="news" class="filter-tab @(activeCategory == "news" ? "active" : "")">TIN ĐIỆN ẢNH</a>
    </div>

    <div class="news-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="news-card">
                    <div class="image-wrap">
                        <img src="@item.ImageUrl" alt="@item.Title" onerror="this.src='https://images.unsplash.com/photo-1568702846914-96b305d2aaeb?w=600'">
                        <span class="category-badge" style="background: #e30613;">@item.CategoryLabel</span>
                    </div>
                    <div class="news-info">
                        <div class="date">📅 @item.DateRange</div>
                        <h3 class="news-title">@item.Title</h3>
                        <p style="font-size: 0.75rem; color: #666; margin: 6px 0 0; line-height: 1.4;">@item.Summary</p>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: white; border-radius: 6px;">
                <p style="color: #666;">Chưa có ưu đãi nào trong danh mục này.</p>
            </div>
        }
    </div>
</main>

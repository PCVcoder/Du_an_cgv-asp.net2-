@{
    ViewData["Title"] = "Danh Sách Phim";
}

@section Styles {
<style>
    .container { max-width: 960px; margin: 0 auto; padding: 0 16px 48px; }
    .breadcrumb { padding: 12px 0; font-size: 0.75rem; color: #666; display: flex; align-items: center; gap: 6px; }
    .breadcrumb a:hover { color: #e30613; }
    
    .title-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; padding-bottom: 8px; border-bottom: 2px solid #e30613; }
    .title-row h1 { font-family: 'Montserrat', 'Roboto', sans-serif; font-weight: 800; font-size: 1.6rem; color: #1a1a1a; margin: 0; letter-spacing: 0.5px; }
    .alt-btn { background: none; border: none; color: #e30613; font-weight: 700; font-size: 0.82rem; padding: 0; letter-spacing: 0.5px; cursor: pointer; text-decoration: none; }
    .alt-btn:hover { text-decoration: underline; }

    /* Movie Card Grid */
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .movie-card { border-radius: 4px; overflow: hidden; background: white; border: 1px solid #e0e0e0; box-shadow: 0 1px 4px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; }
    .movie-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.12); }
    .movie-poster-wrap { position: relative; cursor: pointer; overflow: hidden; }
    .movie-poster-wrap:hover img { transform: scale(1.04); }
    .movie-poster-wrap img { width: 100%; height: 290px; object-fit: cover; display: block; transition: transform 0.25s; }
    
    .rating-badge { position: absolute; top: 6px; left: 6px; color: white; font-size: 0.6rem; font-weight: 700; padding: 2px 6px; border-radius: 2px; z-index: 2; }
    .format-badge { position: absolute; top: 6px; right: 6px; background: #1a1a1a; color: white; font-size: 0.5rem; font-weight: 700; padding: 2px 6px; z-index: 2; border-radius: 2px; }
    
    .movie-info { padding: 12px; display: flex; flex-direction: column; gap: 10px; flex: 1; justify-content: space-between; }
    .movie-title { font-weight: 700; font-size: 0.88rem; margin: 0; color: #222; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-transform: uppercase; }
    
    .movie-card .btn-buy {
        width: 100%; background: #e30613; color: white; border: none; padding: 9px 0;
        font-weight: 700; font-size: 0.8rem; border-radius: 2px; cursor: pointer; text-align: center; display: block; transition: background 0.15s;
    }
    .movie-card .btn-buy:hover { background: #c00010; }
    .meta-text { font-size: 0.72rem; color: #777; margin: 0; display: flex; gap: 8px; }
</style>
}

<main class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
        <a asp-controller="Home" asp-action="Index" style="color: #e30613;">🏠</a>
        <span>›</span>
        <span>Phim</span>
        <span>›</span>
        <span style="color: #e30613; font-weight: 600;">Phim Đang Chiếu</span>
    </nav>

    <!-- Heading row -->
    <div class="title-row">
        <h1>PHIM ĐANG CHIẾU</h1>
        <a href="#sap-chieu" class="alt-btn">PHIM SẮP CHIẾU ›</a>
    </div>

    <!-- Grid -->
    <div class="grid-4">
        <!-- Card 1 -->
        <div class="movie-card">
            <a asp-controller="Movie" asp-action="Detail" asp-route-id="1" class="movie-poster-wrap">
                <div class="rating-badge" style="background: #2e7d32;">T16</div>
                <img src="https://images.unsplash.com/photo-1568038479111-87bf80659645?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Lật Mặt 7: Một Điều Ước">
            </a>
            <div class="movie-info">
                <div>
                    <a asp-controller="Movie" asp-action="Detail" asp-route-id="1" class="movie-title">Lật Mặt 7: Một Điều Ước</a>
                    <div class="meta-text" style="margin-top: 6px;">
                        <span><strong>121</strong> phút</span>
                        <span>|</span>
                        <span>Khởi chiếu: 05/10/2026</span>
                    </div>
                </div>
                <a asp-controller="Booking" asp-action="Index" asp-route-movieId="1" class="btn-buy">MUA VÉ</a>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="movie-card">
            <a asp-controller="Movie" asp-action="Detail" asp-route-id="2" class="movie-poster-wrap">
                <div class="rating-badge" style="background: #b71c1c;">T18</div>
                <div class="format-badge">IMAX</div>
                <img src="https://images.unsplash.com/photo-1778973812223-e5079431fa47?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Vùng Bắt Quỷ Dữ">
            </a>
            <div class="movie-info">
                <div>
                    <a asp-controller="Movie" asp-action="Detail" asp-route-id="2" class="movie-title">Vùng Bắt Quỷ Dữ</a>
                    <div class="meta-text" style="margin-top: 6px;">
                        <span><strong>94</strong> phút</span>
                        <span>|</span>
                        <span>Khởi chiếu: 12/11/2026</span>
                    </div>
                </div>
                <a asp-controller="Booking" asp-action="Index" asp-route-movieId="2" class="btn-buy">MUA VÉ</a>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="movie-card">
            <a asp-controller="Movie" asp-action="Detail" asp-route-id="3" class="movie-poster-wrap">
                <div class="rating-badge" style="background: #b71c1c;">T18</div>
                <img src="https://images.unsplash.com/photo-1651627567991-e4ec7b8fc72c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Tế Vật Cải Mệnh">
            </a>
            <div class="movie-info">
                <div>
                    <a asp-controller="Movie" asp-action="Detail" asp-route-id="3" class="movie-title">Tế Vật Cải Mệnh</a>
                    <div class="meta-text" style="margin-top: 6px;">
                        <span><strong>110</strong> phút</span>
                        <span>|</span>
                        <span>Khởi chiếu: 01/10/2026</span>
                    </div>
                </div>
                <a asp-controller="Booking" asp-action="Index" asp-route-movieId="3" class="btn-buy">MUA VÉ</a>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="movie-card">
            <a asp-controller="Movie" asp-action="Detail" asp-route-id="4" class="movie-poster-wrap">
                <div class="rating-badge" style="background: #e65100;">T13</div>
                <img src="https://images.unsplash.com/photo-1609062757924-6c2d01b3b422?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Kỳ Nghỉ Hè Nhớ Đời">
            </a>
            <div class="movie-info">
                <div>
                    <a asp-controller="Movie" asp-action="Detail" asp-route-id="4" class="movie-title">Kỳ Nghỉ Hè Nhớ Đời</a>
                    <div class="meta-text" style="margin-top: 6px;">
                        <span><strong>105</strong> phút</span>
                        <span>|</span>
                        <span>Khởi chiếu: 25/09/2026</span>
                    </div>
                </div>
                <a asp-controller="Booking" asp-action="Index" asp-route-movieId="4" class="btn-buy">MUA VÉ</a>
            </div>
        </div>

        <!-- Card 5 -->
        <div class="movie-card">
            <a asp-controller="Movie" asp-action="Detail" asp-route-id="5" class="movie-poster-wrap">
                <div class="rating-badge" style="background: #1565c0;">K</div>
                <img src="https://images.unsplash.com/photo-1534447677768-be436bb09401?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=400" alt="Phiêu Lưu Cùng Bé">
            </a>
            <div class="movie-info">
                <div>
                    <a asp-controller="Movie" asp-action="Detail" asp-route-id="5" class="movie-title">Phiêu Lưu Cùng Bé</a>
                    <div class="meta-text" style="margin-top: 6px;">
                        <span><strong>90</strong> phút</span>
                        <span>|</span>
                        <span>Khởi chiếu: 20/10/2026</span>
                    </div>
                </div>
                <a asp-controller="Booking" asp-action="Index" asp-route-movieId="5" class="btn-buy">MUA VÉ</a>
            </div>
        </div>
    </div>
</main>

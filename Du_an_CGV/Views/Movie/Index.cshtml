@model List<Du_an_CGV.Models.Movie>
@{
    var activeTab = (string?)ViewBag.ActiveTab ?? "now-showing";
    var isUpcoming = (activeTab == "upcoming");
    ViewData["Title"] = isUpcoming ? "Phim Sắp Chiếu" : "Phim Đang Chiếu";
}

@section Styles {
<style>
    .container { max-width: 960px; margin: 0 auto; padding: 0 16px 48px; }
    .breadcrumb { padding: 12px 0; font-size: 0.75rem; color: #666; display: flex; align-items: center; gap: 6px; }
    .breadcrumb a:hover { color: #e30613; }
    
    .title-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; padding-bottom: 8px; border-bottom: 2px solid #e30613; }
    .title-row h1 { font-family: 'Montserrat', 'Roboto', sans-serif; font-weight: 800; font-size: 1.6rem; color: #1a1a1a; margin: 0; letter-spacing: 0.5px; }
    .tab-switch { display: flex; gap: 12px; }
    .alt-btn {
        background: none; border: none; font-weight: 700; font-size: 0.85rem; padding: 6px 12px; letter-spacing: 0.5px; cursor: pointer; text-decoration: none; border-radius: 3px;
    }
    .alt-btn.active { background: #e30613; color: white !important; }
    .alt-btn:not(.active) { color: #555; background: #e8e2d8; }
    .alt-btn:hover { text-decoration: none; }

    /* Movie Card Grid */
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .movie-card { border-radius: 4px; overflow: hidden; background: white; border: 1px solid #e0e0e0; box-shadow: 0 1px 4px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; }
    .movie-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.12); }
    .movie-poster-wrap { position: relative; cursor: pointer; overflow: hidden; }
    .movie-poster-wrap:hover img { transform: scale(1.04); }
    .movie-poster-wrap img { width: 100%; height: 290px; object-fit: cover; display: block; transition: transform 0.25s; }
    
    .rating-badge { position: absolute; top: 6px; left: 6px; color: white; font-size: 0.6rem; font-weight: 700; padding: 2px 6px; border-radius: 2px; z-index: 2; }
    .format-badge { position: absolute; top: 6px; right: 6px; background: #1a1a1a; color: white; font-size: 0.5rem; font-weight: 700; padding: 2px 6px; z-index: 2; border-radius: 2px; }
    
    .movie-info { padding: 12px; display: flex; flex-direction: column; gap: 10px; flex: 1; justify-content: space-between; }
    .movie-title { font-weight: 700; font-size: 0.88rem; margin: 0; color: #222; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-transform: uppercase; }
    
    .movie-card .btn-buy {
        width: 100%; background: #e30613; color: white; border: none; padding: 9px 0;
        font-weight: 700; font-size: 0.8rem; border-radius: 2px; cursor: pointer; text-align: center; display: block; transition: background 0.15s;
    }
    .movie-card .btn-buy:hover { background: #c00010; }
    .meta-text { font-size: 0.72rem; color: #777; margin: 0; display: flex; gap: 8px; }
</style>
}

<main class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
        <a asp-controller="Home" asp-action="Index" style="color: #e30613;">🏠</a>
        <span>›</span>
        <span>Phim</span>
        <span>›</span>
        <span style="color: #e30613; font-weight: 600;">@(isUpcoming ? "Phim Sắp Chiếu" : "Phim Đang Chiếu")</span>
    </nav>

    <!-- Heading row -->
    <div class="title-row">
        <h1>@(isUpcoming ? "PHIM SẮP CHIẾU" : "PHIM ĐANG CHIẾU")</h1>
        <div class="tab-switch">
            <a asp-controller="Movie" asp-action="Index" asp-route-tab="now-showing" class="alt-btn @(!isUpcoming ? "active" : "")">Đang Chiếu</a>
            <a asp-controller="Movie" asp-action="Index" asp-route-tab="upcoming" class="alt-btn @(isUpcoming ? "active" : "")">Sắp Chiếu</a>
        </div>
    </div>

    <!-- Grid -->
    <div class="grid-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var m in Model)
            {
                <div class="movie-card">
                    <a asp-controller="Movie" asp-action="Detail" asp-route-id="@m.Id" class="movie-poster-wrap">
                        <div class="rating-badge" style="background: @m.RatingColor;">@m.Rating</div>
                        @if (!string.IsNullOrEmpty(m.SpecialTag))
                        {
                            <div class="format-badge">@m.SpecialTag</div>
                        }
                        <img src="@m.PosterUrl" alt="@m.Title" onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=400'">
                    </a>
                    <div class="movie-info">
                        <div>
                            <a asp-controller="Movie" asp-action="Detail" asp-route-id="@m.Id" class="movie-title">@m.Title</a>
                            <div class="meta-text" style="margin-top: 6px;">
                                <span><strong>@m.Duration</strong> phút</span>
                                <span>|</span>
                                <span>Khởi chiếu: @m.ReleaseDate.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                        @if (m.IsNowShowing && !m.IsUpcoming && ViewBag.ActiveTab != "upcoming")
                        {
                            <a asp-controller="Booking" asp-action="Index" asp-route-movieId="@m.Id" class="btn-buy">MUA VÉ</a>
                        }
                        else
                        {
                            <a asp-controller="Movie" asp-action="Detail" asp-route-id="@m.Id" class="btn-buy" style="background: #1565c0;">XEM CHI TIẾT</a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: white; border-radius: 6px;">
                <p style="font-size: 1.1rem; color: #777;">Hiện tại chưa có phim trong danh mục này.</p>
            </div>
        }
    </div>
</main>
